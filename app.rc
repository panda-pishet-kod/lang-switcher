// ---------------------------------------------------------------------------------------
// English — `[general] language = "en"`.
// ---------------------------------------------------------------------------------------
//
// ⚠ **«Lang Switcher» is not translated** and reads the same in both locales — decision on
// question 7. It is the display name of the product: the caption below, the value name under
// `HKCU\…\Run` (`settings::AUTOSTART_VALUE_NAME`) and the about box all carry it unchanged.
//
// The two entries of the language combo box are **not** in either table on purpose: a
// language is named in its own language in a language chooser, so «Русский» and «English»
// stand as they are whichever locale is in force.
LANGUAGE 0x09, 0x01
STRINGTABLE
BEGIN
    IDS_DIALOG_CAPTION      "Lang Switcher — Settings"
    IDS_GROUP_GENERAL       "General"
    IDS_AUTOSTART           "Start when I sign in"
    IDS_LANGUAGE_LABEL      "Interface language:"
    IDS_LANGUAGE_RESTART    "takes effect after a restart"
    IDS_GROUP_HOTKEY        "Hotkey"
    IDS_HOTKEY_LABEL        "Key:"
    IDS_HOTKEY_SET          "Set"
    IDS_HOTKEY_STOP         "Cancel"
    IDS_GROUP_LAYOUTS       "Layouts"
    IDS_MODE_PAIR           "Pair"
    IDS_MODE_CYCLE          "Several layouts"
    IDS_PAIR_SOURCE         "Source:"
    IDS_PAIR_TARGET         "Target:"
    IDS_CYCLE_HINT          "Cycle: the tick takes part, the buttons set the order"
    IDS_CYCLE_UP            "Up"
    IDS_CYCLE_DOWN          "Down"
    IDS_GROUP_REPLACEMENT   "Replacement"
    IDS_METHOD_BACKSPACE    "Backspace"
    IDS_METHOD_SELECTION    "Selection (compatibility)"
    IDS_DELAY_LABEL         "Delay between events, ms:"
    IDS_GROUP_SELECTION     "Selection"
    IDS_SELECTION_ENABLED   "Convert the selected text"
    IDS_CLIPBOARD_TIMEOUT   "Clipboard timeout, ms:"
    IDS_CLIPBOARD_RESTORE   "Restore delay, ms:"
    IDS_GROUP_EXCLUSIONS    "Exclusions"
    IDS_EXCLUSION_REMOVE    "Remove"
    IDS_EXCLUSION_ADD       "Add"
    IDS_EXCLUSION_HINT      "Process name, for example game.exe"
    IDS_GROUP_DIAGNOSTICS   "Diagnostics"
    IDS_LOG_ENABLED         "Keep a journal"
    IDS_LOG_OPEN            "Open the journal folder"
    IDS_LOG_DIR_LABEL       "Journal folder:"
    IDS_GROUP_STATE         "State"
    IDS_OK                  "OK"
    IDS_CANCEL              "Cancel"
    IDS_APPLY               "Apply"
    IDS_NOTE_TEXT_KEY       "This is a text key: while the program is active it will stop typing its character."
    IDS_NOTE_UNKNOWN_KEY    "The key name is not recognised — the default key, Pause, is in force."
    IDS_CAPTURE_PROMPT      "Press a key. Esc cancels."
    IDS_CAPTURE_MODIFIER    "A modifier on its own cannot be a hotkey."
    IDS_CAPTURE_COMBINATION "Combinations with modifiers are not supported: the settings file holds a single key."
    IDS_CAPTURE_EMERGENCY   "Ctrl+Alt+Shift+F12 is the emergency exit; it cannot be assigned."
    IDS_CAPTURE_NAMELESS    "This key has no name in the settings file — choose another one."
    IDS_CAPTURE_RESERVED    "The system owns this key — choose another one."
    IDS_STATE_HOOK          "Keyboard hook: {0} · hook recoveries: {1} · install failures: {2}"
    IDS_HOOK_UP             "installed"
    IDS_HOOK_DOWN           "NOT INSTALLED"
    IDS_STATE_LAYOUTS       "Layouts in the session: {0} · exclusions published: {1} · journal entries: {2}"
    IDS_STATE_AUTOSTART     "Autostart in the registry (HKCU\\…\\Run): {0}"
    IDS_AUTOSTART_PRESENT   "yes, {0}"
    IDS_AUTOSTART_ABSENT    "no"
    IDS_LAYOUT_NOTE         "The session has no layout named in the file ({0}) — choose again."
    IDS_LAYOUT_WORD_SOURCE  "source"
    IDS_LAYOUT_WORD_TARGET  "target"
    IDS_LOG_DIR_MISSING     "%APPDATA% is not set — there is nowhere to write the journal"
    IDS_METHOD_AUTO         "Automatic (recommended)"
    IDS_THEME_LABEL         "Appearance:"
    IDS_THEME_SYSTEM        "Match system"
    IDS_THEME_LIGHT         "Light"
    IDS_THEME_DARK          "Dark"
END

// ---------------------------------------------------------------------------------------
// The menu of FR-91, both locales. Task T-08-2.
// ---------------------------------------------------------------------------------------
//
// Separate blocks rather than more rows above, because these six identifiers belong to
// `tray` and not to the dialog, and because a string table resource is sixteen strings wide:
// starting the menu at 3072 puts it in a block of its own, so a string added to the dialog
// cannot renumber the menu.
#define IDS_MENU_SUSPEND        3072
#define IDS_MENU_RESUME         3073
#define IDS_MENU_SETTINGS       3074
#define IDS_MENU_AUTOSTART      3075
#define IDS_MENU_ABOUT          3076
#define IDS_MENU_EXIT           3077

LANGUAGE 0x19, 0x01
STRINGTABLE
BEGIN
    IDS_MENU_SUSPEND        "Приостановить"
    IDS_MENU_RESUME         "Возобновить"
    IDS_MENU_SETTINGS       "Настройки…"
    IDS_MENU_AUTOSTART      "Запускать при входе в систему"
    IDS_MENU_ABOUT          "О программе"
    IDS_MENU_EXIT           "Выход"
END

LANGUAGE 0x09, 0x01
STRINGTABLE
BEGIN
    IDS_MENU_SUSPEND        "Suspend"
    IDS_MENU_RESUME         "Resume"
    IDS_MENU_SETTINGS       "Settings…"
    IDS_MENU_AUTOSTART      "Start when I sign in"
    IDS_MENU_ABOUT          "About"
    IDS_MENU_EXIT           "Exit"
END
