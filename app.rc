// ---------------------------------------------------------------------------------------
// Hebrew and Arabic, the two right-to-left locales of вопрос 97. Task Т-30-1.
// ---------------------------------------------------------------------------------------
//
// The tables themselves carry **no direction marks** — no U+200E, no U+200F, no isolates.
// Direction is decided by the code: the window is mirrored by the extended style its template
// is created with (task Т-30-2) and an island of Latin text is turned back to left-to-right
// reading by one function (task Т-30-4). A mark buried in a translation would make an island
// silently, and no sweep over these tables would ever see it — the string would look ordinary.
// The sweep `no_translation_carries_a_direction_mark` in `tests\settings.rs` is the guard.
//
// The arrow of IDS_ABOUT_HELP_5 is «←» and not «→»: it leads the eye from the first place
// named to the second, and in a right-to-left line the first of them stands on the right.

LANGUAGE 0x0D, 0x01
STRINGTABLE
BEGIN
    IDS_DIALOG_CAPTION      "Lang Switcher — הגדרות"
    IDS_GROUP_GENERAL       "כללי"
    IDS_AUTOSTART           "הפעלה עם הכניסה למערכת"
    IDS_LANGUAGE_LABEL      "שפת הממשק:"
    IDS_GROUP_HOTKEY        "מקש קיצור"
    IDS_HOTKEY_LABEL        "מקש:"
    IDS_HOTKEY_SET          "הגדר"
    IDS_HOTKEY_STOP         "ביטול"
    IDS_GROUP_LAYOUTS       "פריסות"
    IDS_MODE_PAIR           "זוג"
    IDS_MODE_CYCLE          "כמה פריסות"
    IDS_PAIR_SOURCE         "מקור:"
    IDS_PAIR_TARGET         "יעד:"
    IDS_CYCLE_HINT          "מחזור: הסימון משתתף, הכפתורים קובעים סדר"
    IDS_CYCLE_UP            "למעלה"
    IDS_CYCLE_DOWN          "למטה"
    IDS_SELECTION_ENABLED   "המרת הטקסט המסומן"
    IDS_GROUP_EXCLUSIONS    "חריגים"
    IDS_EXCLUSION_REMOVE    "הסר"
    IDS_EXCLUSION_ADD       "הוסף"
    IDS_EXCLUSION_HINT      "שם תהליך, למשל game.exe"
    IDS_GROUP_DIAGNOSTICS   "אבחון"
    IDS_LOG_ENABLED         "ניהול יומן"
    // ⚠ Э28 §4 и глоссарий Э30 §3.2: «פתיחת תיקיית היומן» длиннее кнопки. Какой именно папки —
    // сказано подписью прямо под кнопкой.
    IDS_LOG_OPEN            "פתיחת התיקייה"
    IDS_LOG_DIR_LABEL       "תיקייה:"
    IDS_GROUP_STATE         "מצב"
    IDS_OK                  "אישור"
    IDS_CANCEL              "ביטול"
    IDS_APPLY               "החל"
    IDS_NOTE_TEXT_KEY       "זהו מקש כתיבה: כל עוד התוכנית פעילה, הוא יפסיק להקליד את התו שלו."
    IDS_NOTE_UNKNOWN_KEY    "שם המקש לא זוהה — פועל מקש ברירת המחדל, Pause."
    IDS_CAPTURE_PROMPT      "הקישו על מקש…"
