#define IDC_SOUND              1004
#define IDC_HOTKEY             1010
#define IDC_HOTKEY_NOTE        1011
// The button that arms the capture of FR-94, task T-08-2. Next to the field it fills.
#define IDC_HOTKEY_CAPTURE     1012
#define IDC_MODE_PAIR          1020
#define IDC_MODE_CYCLE         1021
