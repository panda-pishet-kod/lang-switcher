// Window and control styles, spelled out numerically for the reason given at the top of this
// file: there is no #include <windows.h> here, so every name below would otherwise be an
// undefined symbol. The values are those of winuser.h and commctrl.h and cannot change --
// they are part of the binary interface of the window manager.
#define DS_SETFONT             0x0040
#define DS_MODALFRAME          0x0080
#define DS_CENTER              0x0800
#define WS_TABSTOP             0x00010000L
#define WS_GROUP               0x00020000L
#define WS_SYSMENU             0x00080000L
#define WS_VSCROLL             0x00200000L
#define WS_BORDER              0x00800000L
#define WS_CAPTION             0x00C00000L
#define WS_VISIBLE             0x10000000L
#define WS_POPUP               0x80000000L
// ⚠ WS_VISIBLE and WS_BORDER are the two styles below that are never *written* into a
// statement -- they are written *out* of one. rc.exe ORs WS_CHILD | WS_VISIBLE into every
// control statement of a dialog whatever the style expression says, and adds WS_BORDER on
// top of that for EDITTEXT and LISTBOX; the only way to take one back off is the NOT
// operator of the style expression, which is why the eight groups below read
// `BS_OWNERDRAW | NOT WS_VISIBLE` and the five fields and two lists read `NOT WS_BORDER`.
// The measurement that says so is in reports\T-11-13.md: before task T-11-13 the eight
// groups came out of rc.exe as 0x5000000B -- WS_CHILD | WS_VISIBLE | BS_OWNERDRAW -- with
// no WS_VISIBLE anywhere in their source text.
// ⚠ BS_OWNERDRAW is the button TYPE, not a flag: button types live in the low nibble of the
// style and replace one another rather than combine. The nine push buttons below carry it so
// that the dialog paints them itself (FR-92а, task T-11-5a) — the low nibble of each style
// becomes 0x0B, and the statements' own default type (BS_PUSHBUTTON 0x00, and 0x01 for the
// former DEFPUSHBUTTON) is absorbed by it: 0x00|0x0B and 0x01|0x0B are both 0x0B.
#define BS_OWNERDRAW           0x0B
// BS_NOTIFY is a style *flag*, unlike the type above, and it is load-bearing: without it a
// button never sends BN_SETFOCUS/BN_KILLFOCUS to its parent. The eight owner-drawn check
// boxes and radio buttons below carry it because BN_SETFOCUS is what returns the arrow-key
// behaviour their former AUTO* types provided by themselves — the dialog manager moves the
// focus along a WS_GROUP run on the arrow keys, an automatic radio button then checked
// itself on arrival, and the dialog procedure of src\settings.rs (task T-11-5b) needs to
// hear about the arrival to do the same by hand.
#define BS_NOTIFY              0x4000
#define ES_AUTOHSCROLL         0x0080
#define ES_READONLY            0x0800
#define ES_NUMBER              0x2000
#define CBS_DROPDOWNLIST       0x0003
#define CBS_HASSTRINGS         0x0200
// ⚠ CBS_OWNERDRAWFIXED is a style *flag*, unlike the button type BS_OWNERDRAW above: combo
// types live in the low two bits (CBS_DROPDOWNLIST is 0x0003) and this bit combines with
// them instead of replacing anything. The four combo boxes below carry it so the dialog
// paints their closed face and their list items itself (FR-92а, task T-11-6), at the fixed
// item height WM_MEASUREITEM answers once. CBS_HASSTRINGS stays load-bearing next to it:
// it is what keeps the item strings stored in the combo itself — the existing population
// writes them with CB_ADDSTRING and the drawing reads them back with CB_GETLBTEXT, neither
// of which an owner-drawn combo does without that flag.
#define CBS_OWNERDRAWFIXED     0x0010
#define LBS_NOTIFY             0x0001
#define LBS_HASSTRINGS         0x0040
#define LBS_NOINTEGRALHEIGHT   0x0100
// ⚠ LBS_OWNERDRAWFIXED is a style *flag*, like CBS_OWNERDRAWFIXED above and unlike the button
// type BS_OWNERDRAW: it combines with the LBS_* flags instead of replacing any of them. The
// exclusion list below carries it (FR-92а, task T-11-14) so that the dialog paints its rows
// itself and the selected row shows the palette's own sel_bg/sel_fg instead of the system
// COLOR_HIGHLIGHT blue -- WM_CTLCOLORLISTBOX can colour the ground of a list but never the
// stripe of its selection. LBS_HASSTRINGS stays load-bearing next to it for exactly the
// reason CBS_HASSTRINGS does: it is what keeps the row strings stored in the control itself,
// so the existing population (LB_ADDSTRING) and the existing reading (LB_GETTEXT, both in
// src\settings.rs) keep working unchanged -- an owner-drawn list box without that flag stores
// no strings at all and would break FR-84.
#define LBS_OWNERDRAWFIXED     0x0010
#define LVS_REPORT             0x0001
#define LVS_SINGLESEL          0x0004
#define LVS_SHOWSELALWAYS      0x0008
#define LVS_NOCOLUMNHEADER     0x4000
// ⚠ SS_OWNERDRAW is the static TYPE, exactly as BS_OWNERDRAW above is the button type: static
// types live in the low nibble of the style (SS_LEFT 0x00, SS_CENTER 0x01, SS_RIGHT 0x02,
// SS_ICON 0x03 …) and replace one another rather than combine. Every LTEXT statement below
// carries it since task T-11-18 (FR-92а) so that the dialog paints its labels itself
// (WM_DRAWITEM, branch ODT_STATIC, in src\settings.rs). The reason is the same one that put
// BS_OWNERDRAW on the buttons and CBS_OWNERDRAWFIXED on the combo boxes, sharpened by task
// T-11-17: this program draws its own text with grey antialiasing, a system-drawn STATIC draws
// its own with the ClearType of the dialog font, and the two smoothings standing in one window
// read as two different type faces on neighbouring lines.
// ⚠ LTEXT's own default type is SS_LEFT 0x00 and it is absorbed by this one exactly as
// BS_PUSHBUTTON 0x00 is absorbed by BS_OWNERDRAW: 0x00|0x0D is 0x0D. What must NOT be absorbed
// is WS_GROUP, which rc.exe adds to an LTEXT with or without a style expression -- the tab
// order of the dialog stands on it, and tests\settings.rs reads it back out of the built exe.
#define SS_OWNERDRAW           0x0D

// FR-90: two visually distinct tray states, each icon carrying the 16/20/24/32 px frames.
// The paths are relative to this file, which sits next to Cargo.toml -- exactly the layout
// proven by the H-9 control build. rc.exe resolves paths inside .rc files in a non-obvious
// way and a wrong one shows up as a silently missing resource, not as an error.
IDI_APP_ACTIVE  ICON  "res/langswitcher-active.ico"
IDI_APP_PAUSED  ICON  "res/langswitcher-paused.ico"
IDI_APP_ACTIVE_UNREAD  ICON  "res/langswitcher-active-unread.ico"
IDI_APP_PAUSED_UNREAD  ICON  "res/langswitcher-paused-unread.ico"

// The manifest is chosen by a /d define passed from build.rs, NOT hard-wired.
//
// A binary carrying uiAccess="true" refuses to start unless it is both signed and located
// in %ProgramFiles% -- CreateProcess returns 740 rather than degrading. Wiring the uiAccess
// manifest in unconditionally makes `cargo test` fail before a single test runs, because
// the test harness is built from this same bin target. Measured during task H-9.
#ifdef LANGSW_UIACCESS
1 24 "app.manifest"
#else
1 24 "app-dev.manifest"
#endif

// Values fixed by decision 8 of DECISIONS.md.
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     0,40,0,0
  PRODUCTVERSION  0,40,0,0
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          0x00040004L
  FILETYPE        0x1L
  FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Panda_Pishet_Kod"
            VALUE "FileDescription",  "Lang Switcher"
            VALUE "FileVersion",      "0.40.0.0"
            VALUE "InternalName",     "LangSwitcher.exe"
            VALUE "LegalCopyright",   "Copyright © 2026 Panda_Pishet_Kod"
            VALUE "OriginalFilename", "LangSwitcher.exe"
            VALUE "ProductName",      "Lang Switcher"
            VALUE "ProductVersion",   "0.40.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// ---------------------------------------------------------------------------------------
// FR-92 -- the settings dialog. Task T-08-1.
// ---------------------------------------------------------------------------------------
//
// Every section of the FR-92 table is a group box below, in the order the requirement prints
// them: Общие, Горячая клавиша, Раскладки, Замена, Выделение, Исключения, Диагностика. The
// eighth group, Состояние, is not from that table: it shows what the modules `watchdog`,
// `guard`, `diag` and `layouts` publish through their public readers, which the file cannot
// carry because it is not configuration.
//
// ⚠ Every string here is Russian, which is exactly the trap fact 6 of section 9 of STATE.md
// describes: without the `#pragma code_page(65001)` at the top of this file rc.exe reads it
// in the system ANSI code page, cp1251 here, and the Cyrillic ends up as mojibake in the
// binary -- with no error at build time and with green tests. The pragma is at the top of
// this file, and `tests\settings.rs` reads these very strings back out of the built
// LangSwitcher.exe and compares them against the expected ones.
//
// ⚠ **The literals below are no longer what the window shows** — task T-08-2. Every one of
// them is now also a row of the two string tables at the end of this file, and the dialog
// sets the text of every control from the table of the locale in force (FR-94). They are kept
// here, character for character identical to the Russian table, for three reasons: the window
// is readable even if a string fails to load, the check task T-08-1 built against the built
// binary keeps working unchanged, and a test asserts template and Russian table agree — which
// is a second, independent witness that neither came out of rc.exe damaged.
//
// This is also why every static label below now carries an identifier of its own instead of
// -1: a control that `GetDlgItem` cannot find is a control whose text cannot be replaced.
//
// Coordinates are dialog units, so the layout follows the system font instead of a pixel
// grid. Two columns, 200 units wide each, at x = 7 and x = 213.
//
// ⚠ **364 units tall and not the 385 of every build up to e25** — task Т-23-2, решение 83,
// which is the user's own choice at control point К-1 off four candidate layouts rendered on
// a stand (`scratchpad-Э23\К-1-*.png`). Removing «Замена» and dissolving «Выделение» freed
// 144 units in the right column and cost the left one 14 — the selection switch moved into
// «Общие» — so the arithmetic of the window changed on both sides at once:
//
//   left  column: «Общие» 7..101, «Горячая клавиша» 105..153, «Раскладки» 157..289;
//   right column: «Исключения» 7..211, «Диагностика» 215..289 — level with the left;
//   «Состояние» 293..337, the buttons at 343, the window ends at 364.
//
// The two numbers the user decided by eye, and neither is arbitrary: the freed space in the
// right column goes to the **exclusions list** (43 units to 163, four rows to fifteen) so
// that the columns end level and the window carries no hole; and «Состояние» stands **four**
// units under the columns — the gap every other pair of groups here has — where the mock-up
// first shown had 25. Cutting that gap is what took the window from 385 to 364.
// ⚠ **Шрифт шаблона 9 → 10 pt** — задача Т-26-3, решение 87 п. 3 («можно трогать верстку и
// расширить модуль и соответственно окно самой программы, чтобы и текст влез и все смотрелось
// гармонично»). Ни одна координата ниже не изменилась, и это НЕ лень, а устройство единицы
// диалога: она ОПРЕДЕЛЕНА через шрифт диалога (базовая единица — средняя ширина знака на 4 по
// X и высота знакоместа на 8 по Y), поэтому окно, выросшее вместе со своим шрифтом, растёт
// целиком и в тех же пропорциях. Текст влезает по построению: и он, и коробки под ним меряются
// одной линейкой.
//
// ⚠ Была ошибка, и её стоит помнить. Первый заход делал ровно наоборот: шрифт шаблона
// оставался 9 pt, а рисование велось СВОИМ лицом на 10 pt. Так сломан единственный инвариант,
// на котором стоит вся эта таблица координат, — и расплата пришла числами: подпись «Язык
// интерфейса:» просила 60,6 единицы при 58 отведённых, «Клавиша:» — 32,6 при 32, а КАЖДАЯ
// девятиединичная подпись обрезала выносные элементы («участие», «порядок» — замерено глазом
// на поднятом окне, scratchpad-Э26\врез-выносные.png). Починка тем путём означала около
// тридцати правок координат руками. Здесь — одна строка, и ни одного нового числа.
//
// Что НЕ растёт вместе со шрифтом: длины, снятые с макетов Э11 в их собственных пикселях и
// приведённые к DPI окна (`theme::scaled`) — радиус скругления, толщина рамки, отступ шапки
// панели, разрядка. Они остаются теми же на экране, и это правильно: рамка в один пиксель на
// более крупной панели — по-прежнему рамка в один пиксель.
//
// ⚠ **Единица выросла ТОЛЬКО ПО ВЕРТИКАЛИ, и это замер, а не ожидание.** Базовая единица по Y
// — высота знакоместа на 8 — поднялась с 1,875 до 2,125 px; базовая единица по X — средняя
// ширина знака на 4 — осталась **1,750 px**: у Segoe UI она целое число пикселей, и 9 pt с
// 10 pt дают одно и то же 7. Поэтому вертикаль вылечилась сама, а две подписи, которым не
// хватало ширины, не вылечились ни на единицу: «Язык интерфейса:» просила 60,6 при 58,
// «Клавиша:» — 32,6 при 32 (scratchpad-Э26\Т-26-3-замер-после.log). Им ширина и добавлена
// ниже, и вместе с ними расширена левая колонка — 200 → 210 единиц, — а правая сдвинута на
// те же 10. Окно 420 → 430 по ширине; по высоте те же 364 единицы, которые теперь просто
// длиннее в пикселях.
IDD_SETTINGS DIALOGEX 0, 0, 430, 364
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
// 0x00040000 = WS_EX_APPWINDOW, spelled numerically like every other constant here — task
// T-21-4, the user's finding П-1: with the window open there was no button on the task bar.
// The owner is the program's hidden UI window, a WS_EX_TOOLWINDOW popup by decision R-20
// point 2, and an owned window inherits its owner's absence from the bar. WS_EX_APPWINDOW
// "forces a top-level window onto the taskbar when the window is visible", and it belongs in
// the template rather than on the live window because the shell reads the style when the
// window is first shown. Modality and the owner are untouched.
EXSTYLE 0x00040000
CAPTION "Lang Switcher — настройки"
FONT 10, "Segoe UI", 400, 0, 0x1
BEGIN
    // -- Общие: автозапуск, язык интерфейса и оформление ---------------------------------
    //
    // The appearance row is FR-92а, task T-11-3. The combo is declared right after
    // IDC_LANGUAGE so the tab order runs language, then appearance; the restart note below
    // is a static and takes no focus. The combo box items are not in the template: a
    // CBS_DROPDOWNLIST is filled by the dialog, from strings 3058, 3059 and 3060 of the
    // locale in force, in that order. The order is the contract: item index 0 is `system`,
    // 1 is `light`, 2 is `dark`, and src\settings.rs holds the pair of functions that own
    // this mapping. This element only stores the choice; painting arrives with T-11-4.
    // ⚠ The four check boxes and two radio buttons of this dialog are CONTROL statements
    // with BS_OWNERDRAW since task T-11-5b (FR-92а): the system glyph is not repainted by
    // any documented means, so the dialog paints the whole element itself (WM_DRAWITEM in
    // src\settings.rs). BS_OWNERDRAW is a button *type* and displaces BS_AUTOCHECKBOX /
    // BS_AUTORADIOBUTTON, which kills the self-switching on clicks and arrow keys — the
    // dialog procedure returns that behaviour by hand (BN_CLICKED, BN_SETFOCUS; the latter
    // is why every one of the six carries BS_NOTIFY). WS_GROUP stays on exactly the elements
    // that had it — the CheckRadioButton range and the arrow-key run in src\settings.rs
    // depend on it — and after task Т-23-2 there is one such run left, the layout mode: the
    // three method radios of «Замена» carried the other, and it went out of the window with
    // its group.
    // ⚠ The six former GROUPBOX statements are CONTROL statements that are **not visible
    // elements at all** since task T-11-13 (FR-92а). They were owner-drawn buttons from
    // T-11-5c until the defect T-11-13 opened on: a button that covers the whole area of
    // its block takes every click on the block's empty ground, redraws itself on the click,
    // and — carrying no WS_CLIPSIBLINGS — lays its own fill over its neighbours, which never
    // learn they were painted over. The whole block went blank. A panel is conceptually the
    // *background* of the block, so it is drawn by the dialog's own background drawing
    // (WM_ERASEBKGND in src\settings.rs) and stopped being an element: `NOT WS_VISIBLE`
    // takes the WS_VISIBLE rc.exe puts on every control statement back off, and an invisible
    // window takes no click, paints nothing and covers nobody.
    //
    // Identifiers, texts, order and coordinates are byte for byte what they were: the FR-94
    // string rows and the SetDlgItemText of the language switch still address these very
    // controls, the background drawing reads each caption back off its own hidden control
    // with GetDlgItemTextW, and the geometry of the panels is these controls' own rectangles.
    // BS_OWNERDRAW stays for the same reason — the type is what keeps the system from ever
    // drawing a group frame — even though no WM_DRAWITEM can now reach them. No WS_TABSTOP
    // was on any group and none appears: a panel takes no focus.
    // ⚠ 94 units. The block has grown twice by the same rule and neither growth was free:
    // decision В-1 (question 55) wrote 66 down as the canon of the moment the «Оформление»
    // row of FR-92а cost; the sound switch of FR-100 made it 80 by the user's own word of
    // 2026-09-01 («место под расширение вниз модуля общие более чем достаточно»); and task
    // Т-23-2, решение 82.2, brings the selection switch of FR-61 here — one more row of 14 —
    // because its own group was left holding nothing else once the two clipboard timings went
    // into the file. The units come, as they did the last time, out of the air under
    // «Раскладки»; unlike the last time the window itself IS re-cut, and the number that
    // moved is not this one but the gap over «Состояние» — see the header of the template.
    CONTROL         "Общие", IDC_GROUP_GENERAL, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 7, 7, 210, 94
    CONTROL         "Запускать при входе в систему", IDC_AUTOSTART, "Button", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 19, 196, 10
    // ⚠ 64 единицы и не 58: задача Т-26-3 замерила подпись в лице, которым её рисуют, — 60,6
    // единицы. При 58 она переносилась, и в окне оставалось «Язык». Ширина комбо — 54, как
    // запечатало решение 82.2 «по содержимому»: место взято ростом колонки, а не ужатием комбо.
    LTEXT           "Язык интерфейса:", IDC_LANGUAGE_LABEL, 14, 34, 64, 9, SS_OWNERDRAW
    COMBOBOX        IDC_LANGUAGE, 80, 32, 54, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    // ⚠ The «Оформление» row sits at y = 54 and not at the 46 it had until task T-12-3, and the
    // number does not move now that the hint beside the language row is gone. Until task Т-31-3
    // this y was arithmetic — «two units below the bottom of the hint», 32 + 18 = 50 — because an
    // SS_OWNERDRAW static fills its own rectangle with panel_bg before it writes a word, so a
    // static overlapping a combo box does not merely sit on top of it: it *erases* the top of
    // the frame the background drew, which is what defect Г-1 was. The hint has been retired by
    // решение 99.4, the overlap can no longer happen, and **the layout stays exactly where it
    // is**: решение 87 accepted these coordinates by eye, and a row that moved because a
    // neighbour left would be a change nobody asked for. The place right of the language combo
    // is simply empty now.
    LTEXT           "Оформление:", IDC_THEME_LABEL, 14, 54, 64, 9, SS_OWNERDRAW
    COMBOBOX        IDC_THEME, 80, 52, 100, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    // FR-100, task Т-21-5 — the sound switch, a row of «Общие» like the three above it.
    //
    // ⚠ It was nine units tall at y = 64 for one delivery, wedged into the strip left over
    // between the appearance combo (which ends at y = 64.0, measured on the live window) and
    // the old bottom edge of the panel. That was the wrong trade and the user said so: the
    // panel had room to grow because the left column carries 53 units of air under
    // «Раскладки». Ten units like every other check box, four units of air under the combo,
    // nine units of padding under it — the spacing the other groups already had.
    CONTROL         "Звуковой отклик", IDC_SOUND, "Button", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 68, 196, 10
    // FR-61, FR-65 — the selection switch, and since task Т-23-2 (решение 82.2) a row of
    // «Общие» like the three above it.
    //
    // It stood in a group of its own, «Выделение», together with the two clipboard timings of
    // §4.7. Решение 81 sent those two into the file, and a group of one check box is not a
    // group: the switch is a program-wide behaviour like autostart and sound, so it joins its
    // sisters here and the group is gone. Ten units and fourteen below the row above — the
    // step every check box of this block keeps; nine units of padding under it — the same
    // padding the sound switch had when it was last.
    CONTROL         "Конвертировать выделенный текст", IDC_SELECTION_ENABLED, "Button", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 82, 196, 10

    // -- Горячая клавиша -----------------------------------------------------------------
    //
    // The field stays `ES_READONLY`: the key is not typed into it, it is *captured* — FR-94,
    // task T-08-2. The button next to it arms the capture, the field then shows the name of
    // the key that was pressed, and the label below it says what is wrong when the press
    // cannot become a hotkey.
    CONTROL         "Горячая клавиша", IDC_GROUP_HOTKEY, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 7, 105, 210, 48
    // ⚠ The two EDITTEXT of this template are 8 units tall since task T-12-3, and not the 12
    // of the box the mock-ups draw round them. Eight vertical units are one height of the
    // dialog font by the definition of the unit, so the control is exactly the em box of its
    // own text: a single-line EDIT lays that text along the top of its client area and no
    // documented message moves it, so any surplus inside the control would all fall below the
    // glyphs (the 3 above / 11 below of defect Г-3). The 12-unit box of the generator is drawn
    // round the control by the dialog's own background, centred on it (FIELD_BOX_DLU in
    // src\settings.rs), which puts the surplus above and below the text in equal halves. Each
    // y is therefore two units lower than the box it stands in: the box, not the control, is
    // what the eye sees and what the mock-up places.
    // ⚠ 40 единиц и не 32: замер Т-26-3 — подпись просит 32,6 при 32 отведённых, то есть не
    // влезала на шесть десятых единицы. Ровно та же болезнь, что у подписи языка выше.
    LTEXT           "Клавиша:", IDC_HOTKEY_LABEL, 14, 120, 40, 9, SS_OWNERDRAW
    // ⚠ 100 units wide and not the 64 it was until task Т-23-5, and the button stands at the
    // right edge of the block instead of beside the field. Решение 82.6 puts the invitation
    // «Нажмите клавишу…» **into this field**, and at 64 units that sentence ran into its own
    // frame — measured on the raised window, not predicted. The mock-up draws the same shape:
    // a field that takes the width and a button at the end of the row.
    EDITTEXT        IDC_HOTKEY, 56, 120, 104, 8, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    PUSHBUTTON      "Задать", IDC_HOTKEY_CAPTURE, 164, 117, 46, 14, BS_OWNERDRAW
    LTEXT           "", IDC_HOTKEY_NOTE, 14, 134, 196, 16, SS_OWNERDRAW

    // -- Раскладки: FR-30, FR-31, FR-35 --------------------------------------------------
    CONTROL         "Раскладки", IDC_GROUP_LAYOUTS, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 7, 157, 210, 132
    CONTROL         "Пара", IDC_MODE_PAIR, "Button", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP | WS_GROUP, 14, 169, 64, 10
    CONTROL         "Несколько раскладок", IDC_MODE_CYCLE, "Button", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 82, 169, 128, 10
    LTEXT           "Источник:", IDC_PAIR_SOURCE_LABEL, 14, 185, 42, 9, SS_OWNERDRAW
    COMBOBOX        IDC_PAIR_SOURCE, 58, 183, 152, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Цель:", IDC_PAIR_TARGET_LABEL, 14, 201, 42, 9, SS_OWNERDRAW
    COMBOBOX        IDC_PAIR_TARGET, 58, 199, 152, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Цикл: галочка — участие, кнопки — порядок", IDC_CYCLE_HINT, 14, 216, 196, 9, SS_OWNERDRAW
    // ⚠ No WS_BORDER since task T-11-13: the system border is a sunken rectangle drawn by
    // the system in the system's colours, and the mock-ups ask for a rounded field_border
    // frame. The frame is drawn by the dialog's own background drawing, one pixel outside
    // this rectangle — see src\settings.rs.
    CONTROL         "", IDC_CYCLE_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_TABSTOP, 14, 227, 148, 44
    PUSHBUTTON      "Выше", IDC_CYCLE_UP, 166, 227, 44, 14, BS_OWNERDRAW
    PUSHBUTTON      "Ниже", IDC_CYCLE_DOWN, 166, 244, 44, 14, BS_OWNERDRAW
    LTEXT           "", IDC_LAYOUT_NOTE, 14, 274, 196, 10, SS_OWNERDRAW

    // -- Исключения: FR-84 — первая группа правой колонки с задачи Т-23-2 -----------------
    //
    // ⚠ The group is 204 units and its list 163, against the 84 and 43 they were up to e25 —
    // решение 83 п. 1, the user's choice at К-1. This is where the 120 units «Замена» and
    // «Выделение» left behind went: an exclusion list is the one thing in this window that
    // genuinely grows with use, and the alternative candidate — both groups at their present
    // height, the bottom of the right column left empty — is the one the user turned down.
    // Four rows of names became fifteen, and the two columns now end level, both at 289.
    // ⚠ Вся правая колонка сдвинута на +10 единиц — ровно на столько, на сколько выросла
    // левая (задача Т-26-3, решение 87 п. 3). Ни одна её собственная ширина не изменилась:
    // колонке добавили не места, а адрес.
    CONTROL         "Исключения", IDC_GROUP_EXCLUSIONS, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 223, 7, 200, 204
    // ⚠ The list stands one unit below the button beside it, and its own frame then lands on
    // the same row as the button's: the frame of a list is drawn LIST_FIRST_ROW_TOP above the
    // control (2 px at 96 DPI, the air of the mock-ups before the first row, task T-11-16),
    // where a button frames its own rectangle. Declared level, they came out 2 px apart, which
    // was defect Д-3; the height is one unit short of the box so that its bottom does not move.
    LISTBOX         IDC_EXCLUSIONS, 230, 20, 120, 163, LBS_NOTIFY | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    PUSHBUTTON      "Удалить", IDC_EXCLUSION_REMOVE, 356, 19, 60, 14, BS_OWNERDRAW
    EDITTEXT        IDC_EXCLUSION_NAME, 230, 188, 120, 8, ES_AUTOHSCROLL | NOT WS_BORDER
    PUSHBUTTON      "Добавить", IDC_EXCLUSION_ADD, 356, 185, 60, 14, BS_OWNERDRAW
    LTEXT           "Имя процесса, например game.exe", IDC_EXCLUSION_HINT, 230, 200, 186, 9, SS_OWNERDRAW

    // -- Диагностика: SEC-07 -------------------------------------------------------------
    //
    // Unchanged in every number but its origin: 74 units as it always was, and its bottom
    // edge is what makes the right column end level with the left (215 + 74 = 289).
    CONTROL         "Диагностика", IDC_GROUP_DIAGNOSTICS, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 223, 215, 200, 74
    CONTROL         "Вести журнал", IDC_LOG_ENABLED, "Button", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 230, 227, 90, 10
    PUSHBUTTON      "Открыть папку журнала", IDC_LOG_OPEN, 330, 225, 86, 14, BS_OWNERDRAW
    LTEXT           "Папка журнала:", IDC_LOG_DIR_LABEL, 230, 243, 60, 9, SS_OWNERDRAW
    // ⚠ The **only** two-line label since task Т-31-3 retired the restart hint — 16 units for a
    // path that does not fit on one line. Its DT_WORDBREAK is load-bearing; task T-11-18.
    // Nine units under its own caption, which is the generator's own step (ui.ps1: y = 264
    // and y = 273 in the numbering of the window this group had before Т-23-2).
    LTEXT           "", IDC_LOG_DIR, 230, 252, 186, 16, SS_OWNERDRAW

    // -- Состояние: читатели модулей, не конфигурация -------------------------------------
    //
    // ⚠ Four units under the columns — решение 83 п. 3, the user's word at К-1 («расстояние
    // между блоком состояние и верхними уменьшить до стандартной величины»). Four is that
    // standard: it is the gap between «Общие» and «Горячей клавишей», between «Горячей
    // клавишей» and «Раскладками», and between «Исключениями» и «Диагностикой». It was 25 in
    // the candidate first shown and 39 in every build up to e25.
    // «Состояние» идёт во всю ширину окна и потому растёт вместе с ней: 406 → 416, строки
    // 392 → 402.
    CONTROL         "Состояние", IDC_GROUP_STATE, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 7, 293, 416, 44
    LTEXT           "", IDC_STATE_HOOK, 14, 305, 402, 9, SS_OWNERDRAW
    LTEXT           "", IDC_STATE_LAYOUTS, 14, 316, 402, 9, SS_OWNERDRAW
    LTEXT           "", IDC_STATE_AUTOSTART, 14, 327, 402, 9, SS_OWNERDRAW

    // «ОК» was DEFPUSHBUTTON until task T-11-5a. BS_OWNERDRAW is a button type and occupies
    // the same low nibble BS_DEFPUSHBUTTON lived in, so the default-button *style* cannot
    // survive owner drawing. The behaviour survives by the documented replacement: the dialog
    // sends itself DM_SETDEFID with IDOK on WM_INITDIALOG (src\settings.rs), so Enter still
    // lands on «ОК»; the accent face is painted by WM_DRAWITEM, keyed on the identifier.
    PUSHBUTTON      "ОК", IDOK, 263, 343, 50, 14, BS_OWNERDRAW
    PUSHBUTTON      "Отмена", IDCANCEL, 317, 343, 50, 14, BS_OWNERDRAW
    PUSHBUTTON      "Применить", IDC_APPLY, 371, 343, 52, 14, BS_OWNERDRAW
END

// ---------------------------------------------------------------------------------------
// FR-92а -- the about dialog. Task T-11-11.
// ---------------------------------------------------------------------------------------
//
// The window FR-92а names alongside the settings dialog and the tray menu: «О программе» in
// both palettes. A MessageBoxW cannot be repainted by any documented means, so the box the
// tray used to show becomes this template, drawn by src\settings.rs with the same
// WM_CTLCOLOR* answers and the same owner-drawn button path as the settings dialog.
//
// The rules of the template above hold here unchanged. The literals are Russian and are
// character for character the rows of the Russian table below (FR-94 sets the text of every
// control from the table of the locale in force; the literals keep the window readable if a
// string fails to load). The version line is empty on purpose: it is composed at
// WM_INITDIALOG from IDS_ABOUT_VERSION and the VERSIONINFO resource of the running
// executable — the number is substituted, never spelled here (a second copy of it would be
// a second place for it to be wrong). The name row stays a template literal and no table
// row: «Lang Switcher» is not translated — decision on question 7 — and the about box
// carries it unchanged.
//
// The icon control shows IDI_APP_ACTIVE. ⚠ **The statement's width and height are ignored by
// the dialog manager** — an SS_ICON static sizes itself to the icon it holds, which is why the
// template used to show a 32 px frame however many units it declared (finding A-08). Task
// T-12-4 stopped fighting that and used it: src\settings.rs loads the frame at 40 × 40 with
// LoadImageW and hands it to this control with STM_SETICON, and the control resizes itself to
// exactly the 40 px of the mock-up. The units below are kept honest all the same — they say
// where the icon's top left corner is, which the manager does obey.
//
// «ОК» is BS_OWNERDRAW like the nine buttons above — the type displaces BS_DEFPUSHBUTTON, so
// the default comes from DM_SETDEFID on WM_INITDIALOG, which keeps Enter landing on it; Esc is
// IDCANCEL, which a dialog answers with or without a button.
//
// ⚠ **Every rectangle below is disjoint from every other, and that is load-bearing** — task
// T-12-4. An owner-drawn static answers for the whole of its rectangle and fills it before it
// writes a word (`paint_label`), so two overlapping children would erase one another on every
// repaint. The two description lines are therefore 176 px wide and stop 2 px short of «ОК»
// instead of running the mock-up's full 241 px into the button's rows: решение В-2 keeps two
// live sentences where the mock-up has one, and two sentences take four wrapped lines, which
// reach down beside the button. The narrower column has a second virtue — at 176 px the first
// sentence wraps to two lines in **both** locales, so the fixed 32 px step to the second
// static is right in both; at 241 px the English one would fit on a single line and leave a
// hole between the sentences.
//
// The units are the mock-up's numbers through MulDiv(dlu, 7|15, 4|8) with the rounding the
// dialog manager does: 191 × 79 DLU is 334 × 148 client px — 336 × 180 with the frame, against
// the 335,7 × 178,6 of scratchpad-Э11\chrome.ps1 (A-01).
// ⚠ **233 units tall and not the 79 of every build up to e25** — task Т-23-4, решение 82.5.
// The window gains the panel «Как пользоваться» of the accepted mock-up: five numbered rows,
// «ОК» moves down under them, the width 191 does not move at all.
//
// The height is **measured on the raised window, not the ≈175 the mock-up estimated**, and the
// difference is one honest number. The estimate assumed every row takes one line; four of the
// ten lines the two locales really need come from rows that wrap. The text column is 142 units
// — 249 px at 96 DPI — and the counts, read off the window in both locales
// (`scratchpad-Э23\Т-23-4-опрограмме-*.png`), are 3, 2, 2, 1, 2 in Russian and 3, 2, 2, 1, 1
// in English. A template has one set of rectangles for the two languages, so every row is
// given the taller of its two.
// ⚠ **233 → 256 units tall, and the width 191 is untouched** — task Т-26-2, решение 85. The
// body of this window is set one step above the dialog font since that decision, and the air
// between its lines is 1,4 of the face instead of the 1,33 `DrawTextW` gives on its own; every
// row of text therefore takes more room than it did, and the room is taken downwards. The
// numbers below are **read off the raised window in both locales**, exactly as task Т-23-4 read
// its own — `scratchpad-Э26\Т-26-1-*.png` — because `MeasureString` overestimates the wrap and
// has already cost this template a row of air once (see the note at the help panel).
IDD_ABOUT DIALOGEX 0, 0, 191, 256
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
// 0x00040000 = WS_EX_APPWINDOW — task T-21-4, П-1, for the reason given at IDD_SETTINGS: the
// «О программе» window is owned by the same WS_EX_TOOLWINDOW window and was equally absent
// from the task bar. Both windows of FR-92 are fixed, because the user named both.
EXSTYLE 0x00040000
CAPTION "О программе"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP_ACTIVE, IDC_ABOUT_ICON, 12, 13, 23, 22
    LTEXT           "Lang Switcher", IDC_ABOUT_NAME, 42, 12, 141, 11, SS_OWNERDRAW
    LTEXT           "", IDC_ABOUT_VERSION, 42, 24, 141, 8, SS_OWNERDRAW
    // ⚠ 141 units wide and not the 101 they were until task Т-26-2: the accepted mock-up runs
    // its `.applines` the full width of the text column, level with the name above them, and
    // at 101 units the larger face of решение 85 broke both sentences into three lines apiece.
    // Two lines each, 10 units of air under the version line — `.applines { margin-top: 10px }`
    // of the mock-up, which is 5,3 vertical units here.
    LTEXT           "Исправляет текст, набранный в неверной раскладке.", IDC_ABOUT_LINE_1, 42, 37, 141, 20, SS_OWNERDRAW
    LTEXT           "Перекодировка — по нажатию одной клавиши.", IDC_ABOUT_LINE_2, 42, 57, 141, 20, SS_OWNERDRAW

    // -- «Как пользоваться»: FR-92а, task Т-23-4, решение 82.5 ----------------------------
    //
    // The panel is a hidden CONTROL on the terms the six panels of the settings dialog are on
    // (`NOT WS_VISIBLE`, BS_OWNERDRAW as a *type*): it takes no click, paints nothing and
    // carries two things the drawing needs — the caption, which FR-94 replaces on it like any
    // other control's text, and the rectangle, which is the block. The panel is drawn by the
    // window's own WM_ERASEBKGND in `src\settings.rs`, in the very style the groups of the
    // settings dialog are drawn in: panel_bg inside, panel_border round, the caption in cap.
    //
    // ⚠ Every rectangle below is disjoint from every other, and that is load-bearing for the
    // same reason it is in the settings template: an SS_OWNERDRAW static fills the whole of
    // its own rectangle before it writes a word, so two overlapping statics erase each other.
    //
    // The numerals are template literals with no string row of their own: a digit reads the
    // same in both locales, exactly as «Lang Switcher» does. They are muted, the rows beside
    // them are not — the mock-up's `.key` against its row text — and the split lives in
    // `about_static_color_role`.
    //
    // The rows' own heights are the line counts **read off the raised window in both
    // locales** — `scratchpad-Э26\Т-26-1-*.png`, task Т-26-2, after
    // `scratchpad-Э23\Т-23-4-опрограмме-*.png` before it — and each row is given the taller of
    // its two. ⚠ Not the counts `MeasureString` predicted: that instrument answered two lines
    // for the fourth row in both locales and the window drew one, so the prediction cost a row
    // nine units of air until it was measured on the real thing. The first line of every row
    // stands level with its numeral; a numeral is one line tall and needs no more.
    //
    // ⚠ **Re-cut by решение 85.** The unit of a row is no longer 9 units but **10**: the body
    // is set one step larger and its lines stand 1,4 of the face apart (18 px against 15 at
    // 96 DPI, which is 9,6 vertical units). A row of `n` lines therefore needs
    // (n − 1) × 9,6 + 9,1 units, rounded up: 29 for three lines, 19 for two, 10 for one. The
    // fourth row, one line in both locales until this task, is **two** now — the same sentence
    // in a wider face — and that is measured, not predicted. The air between rows stays the
    // mock-up's `margin-top: 7px`, which is 4 units here.
    CONTROL         "Как пользоваться", IDC_ABOUT_HELP, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 12, 83, 167, 142
    LTEXT           "1", IDC_ABOUT_HELP_N1, 19, 97, 7, 10, SS_OWNERDRAW
    LTEXT           "", IDC_ABOUT_HELP_1, 30, 97, 142, 29, SS_OWNERDRAW
    LTEXT           "2", IDC_ABOUT_HELP_N2, 19, 130, 7, 10, SS_OWNERDRAW
    LTEXT           "", IDC_ABOUT_HELP_2, 30, 130, 142, 19, SS_OWNERDRAW
    LTEXT           "3", IDC_ABOUT_HELP_N3, 19, 153, 7, 10, SS_OWNERDRAW
    LTEXT           "", IDC_ABOUT_HELP_3, 30, 153, 142, 19, SS_OWNERDRAW
    LTEXT           "4", IDC_ABOUT_HELP_N4, 19, 176, 7, 10, SS_OWNERDRAW
    LTEXT           "", IDC_ABOUT_HELP_4, 30, 176, 142, 19, SS_OWNERDRAW
    LTEXT           "5", IDC_ABOUT_HELP_N5, 19, 199, 7, 10, SS_OWNERDRAW
    LTEXT           "", IDC_ABOUT_HELP_5, 30, 199, 142, 19, SS_OWNERDRAW

    // FR-103, task Т-32-4: the way into «От автора». It stands to the left of «ОК» and the
    // window does not grow — решение 101 п. 7 — which is why it takes the air that was already
    // there rather than a row of its own. 86 units is 150 px at 96 DPI: the longest of the
    // fourteen captions measured by the fitting stand with room to spare, and it stops 46 units
    // short of «ОК», so the two never meet however wide a locale writes it.
    PUSHBUTTON      "От автора…", IDC_ABOUT_AUTHOR, 12, 235, 86, 14, BS_OWNERDRAW
    PUSHBUTTON      "ОК", IDOK, 144, 235, 39, 14, BS_OWNERDRAW
END

// =======================================================================================
// FR-101 and FR-103 -- the windows of the letters from the author. Task Т-32-2.
// =======================================================================================
//
// ⚠ **Three templates, and every rectangle in them is a slot rather than a layout.**
//
// The two windows above are laid out to the unit in this file, and each was cut against a
// mock-up measured on the raised window (tasks Т-23-4, Т-26-2). These three cannot be: one
// template serves five letters, a letter's panel holds between nothing and four rows, and the
// text of a news item comes out of the author's feed at run time. So `letters::layout` places
// every control top to bottom out of the height its own text actually needs, measured with the
// same `DrawTextW` that will draw it, and hides the slots this letter does not use.
//
// What the templates below therefore fix is exactly three things, and they are the three that
// cannot be decided at run time: **the size of the window**, **the font its units are in**, and
// **which slots exist at all**. The `x`, `y` and `cy` of every child are starting values that
// the layout overwrites before the window is shown.
//
// The width is 191 units, which is the about window's, and the font is its font — 9 pt — so the
// two windows are the same 334 px wide at 96 DPI and one set of paddings serves both. The
// height is 296 units: the accepted mock-up draws the tallest letter at about 555 px, and
// 555 × 8 / 15 is 296. Решение 101 п. 7 fixes it there for every letter, so that a person does
// not meet a window that changes size depending on what the author had to say.

IDD_LETTER DIALOGEX 0, 0, 191, 296
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
// 0x00040000 = WS_EX_APPWINDOW, for the reason the two windows above carry it: the owner is
// this program's hidden WS_EX_TOOLWINDOW window, and an owned window inherits its owner's
// absence from the task bar. A letter that cannot be found on the task bar is a letter that
// cannot be found at all — and unlike those two, this one is **modeless** and may sit open.
EXSTYLE 0x00040000
CAPTION "Письмо от автора"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP_ACTIVE, IDC_LETTER_ICON, 12, 13, 23, 22
    LTEXT           "", IDC_LETTER_TITLE, 42, 12, 141, 22, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_SUBTITLE, 42, 35, 141, 9, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_LEAD, 42, 46, 141, 40, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_PARA, 12, 88, 167, 30, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_DEMO, 12, 120, 167, 34, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_DEMO_CAP, 12, 156, 167, 20, SS_OWNERDRAW
    CONTROL         "", IDC_LETTER_PANEL, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 12, 180, 167, 80
    LTEXT           "", IDC_LETTER_PANEL_TITLE, 19, 194, 153, 11, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_PANEL_TEXT, 19, 206, 153, 30, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_N1, 19, 194, 7, 10, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_N2, 19, 208, 7, 10, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_N3, 19, 222, 7, 10, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_N4, 19, 236, 7, 10, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_ROW_1, 30, 194, 142, 12, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_ROW_2, 30, 208, 142, 12, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_ROW_3, 30, 222, 142, 12, SS_OWNERDRAW
    LTEXT           "", IDC_LETTER_ROW_4, 30, 236, 142, 12, SS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTER_PANEL_BTN_1, 19, 250, 86, 14, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTER_PANEL_BTN_2, 109, 250, 63, 14, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTER_LEFT, 12, 268, 74, 14, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTER_RIGHT, 90, 268, 44, 14, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTER_ACCENT, 138, 268, 41, 14, BS_OWNERDRAW
    LTEXT           "", IDC_LETTER_FOOT, 12, 284, 167, 10, SS_OWNERDRAW
END

// «Последние письма» — FR-101. The letter's outline with four entry slots in place of the
// rows: each entry is a heading, a line of «when and whether it was read», one line of the
// text, and up to two buttons. Built in stage А and filled in stage Б, when there is a feed to
// fill it from.
IDD_LETTERS_LIST DIALOGEX 0, 0, 191, 296
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE 0x00040000
CAPTION "Последние письма"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_LETTERS_PANEL, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 12, 12, 167, 240
    LTEXT           "", IDC_LETTERS_T1, 19, 20, 153, 11, SS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_D1, 19, 32, 153, 9, SS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_X1, 19, 42, 153, 20, SS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTERS_B1, 19, 63, 60, 13, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTERS_R1, 83, 63, 48, 13, BS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_T2, 19, 82, 153, 11, SS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_D2, 19, 94, 153, 9, SS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_X2, 19, 104, 153, 20, SS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTERS_B2, 19, 125, 60, 13, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTERS_R2, 83, 125, 48, 13, BS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_T3, 19, 144, 153, 11, SS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_D3, 19, 156, 153, 9, SS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_X3, 19, 166, 153, 20, SS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTERS_B3, 19, 187, 60, 13, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTERS_R3, 83, 187, 48, 13, BS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_T4, 19, 206, 153, 11, SS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_D4, 19, 218, 153, 9, SS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_X4, 19, 228, 153, 20, SS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTERS_B4, 19, 249, 60, 13, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTERS_R4, 83, 249, 48, 13, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_LETTERS_CLOSE, 138, 268, 41, 14, BS_OWNERDRAW
    LTEXT           "", IDC_LETTERS_FOOT, 12, 284, 167, 10, SS_OWNERDRAW
END

// «От автора» — FR-103. Wider than a letter and the one window of the three whose height the
// content decides: the accepted mock-up draws it 430 px across, and 430 × 4 / 7 is 246 units at
// this font. Three panels, and the middle one has two states — before the feed has shown a
// letter it carries a quiet line saying the setting is edited in the file, and after it (and
// after ninety days) a switch stands in that line's place (FR-102).
IDD_AUTHOR DIALOGEX 0, 0, 246, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE 0x00040000
CAPTION "От автора"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP_ACTIVE, IDC_AUTHOR_ICON, 12, 13, 23, 22
    LTEXT           "Lang Switcher", IDC_AUTHOR_NAME, 42, 12, 192, 12, SS_OWNERDRAW
    LTEXT           "", IDC_AUTHOR_VERSION, 42, 25, 192, 9, SS_OWNERDRAW
    CONTROL         "", IDC_AUTHOR_PANEL, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 12, 44, 222, 76
    LTEXT           "", IDC_AUTHOR_TEXT, 19, 60, 208, 40, SS_OWNERDRAW
    PUSHBUTTON      "", IDC_AUTHOR_SUPPORT, 19, 101, 110, 14, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_AUTHOR_CHANNEL, 133, 101, 63, 14, BS_OWNERDRAW
    CONTROL         "", IDC_NEWS_PANEL, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 12, 126, 222, 100
    LTEXT           "", IDC_NEWS_ABOUT, 19, 142, 208, 30, SS_OWNERDRAW
    CONTROL         "", IDC_NEWS_SWITCH, "Button", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 19, 142, 208, 10
    LTEXT           "", IDC_NEWS_SWITCH_SUB, 32, 153, 195, 20, SS_OWNERDRAW
    LTEXT           "", IDC_NEWS_STATE, 19, 175, 208, 20, SS_OWNERDRAW
    LTEXT           "", IDC_NEWS_VERSION, 19, 196, 208, 10, SS_OWNERDRAW
    PUSHBUTTON      "", IDC_NEWS_DOWNLOAD, 19, 207, 110, 14, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_NEWS_LETTERS, 133, 207, 63, 14, BS_OWNERDRAW
    LTEXT           "", IDC_NEWS_FILE_ONLY, 19, 223, 208, 10, SS_OWNERDRAW
    CONTROL         "", IDC_FEEDBACK_PANEL, "Button", BS_OWNERDRAW | NOT WS_VISIBLE, 12, 232, 222, 60
    LTEXT           "", IDC_FEEDBACK_TEXT, 19, 248, 208, 30, SS_OWNERDRAW
    PUSHBUTTON      "", IDC_FEEDBACK_WRITE, 19, 273, 110, 14, BS_OWNERDRAW
    PUSHBUTTON      "", IDC_AUTHOR_CLOSE, 193, 296, 41, 14, BS_OWNERDRAW
END

// =======================================================================================
// FR-94 -- the interface strings, one string table per locale. Task T-08-2.
// =======================================================================================
//
// ⚠ **The code page again, and this is the file's sharpest case.** Both tables below are
// full of Cyrillic, and `rc.exe` with no declaration reads a .rc in the system ANSI code
// page — cp1251 on this machine — turning every Russian string into mojibake **with no error
// at build time and with green tests**. The `#pragma code_page(65001)` at the top of this
// file governs the whole of it, tables included, and it is repeated immediately below so
// that the declaration is visible from the strings it protects rather than eight hundred
// lines away. The pragma is idempotent; two of them cost nothing and the second one cannot
// be lost by an edit that moves the tables to a file of their own.
//
// The result is not taken on trust: `tests\settings.rs` reads both tables back out of the
// **built** `LangSwitcher.exe`, opened with `LOAD_LIBRARY_AS_DATAFILE`, and compares every
// string against a literal written out in the test — the technique task T-08-1 established
// for the dialog template (barrier §4.4 of STATE.md: `embed-resource` links resources into
// binary targets only, so a test cannot look for them in its own image).
#pragma code_page(65001)

// The two locales of FR-94 as language identifiers. Spelled numerically for the reason given
// at the top of this file — there is no `#include <windows.h>` here — and these are the
// values `winnt.h` gives: LANG_RUSSIAN 0x19 with SUBLANG_DEFAULT 0x01 is LANGID 0x0419, and
// LANG_ENGLISH 0x09 with SUBLANG_ENGLISH_US 0x01 is 0x0409. `settings::Language` carries the
// same two numbers and `FindResourceExW` is asked for one of them by name of the locale the
// configuration chose — never by the user's Windows UI language, which is not what section 7
// says the choice is.
//
// The `LANGUAGE` statement below applies to the resources that follow it, and there are none
// after the tables: the icons, the manifest, VERSIONINFO and the dialog template are all
// above this line and keep the language they were emitted with.

// Identifiers of the interface strings. The numbering starts at 3000, clear of the dialog
// (200) and of the control identifiers (1001–1080), and it is contiguous: a string table
// resource holds sixteen strings per block, so a gap costs a whole block of nothing.
//
// ⚠ Mirrored by hand in `src\settings.rs`, exactly as the control identifiers are, because a
// .rc file and a Rust file share no header. A mismatch is not silent: the string comes back
// empty, `report_non_critical("FindResourceExW")` records the refusal, and the test that
// reads the tables out of the built binary compares them against the identifiers the crate
// exports.
#define IDS_DIALOG_CAPTION      3000
#define IDS_GROUP_GENERAL       3001
#define IDS_AUTOSTART           3002
#define IDS_LANGUAGE_LABEL      3003
// ⚠ **3004 is retired, not free** — task Т-31-3, решение 99.4. It was IDS_LANGUAGE_RESTART,
// «вступит в силу после перезапуска»: решения 83 и 83а.2 put the sentence beside the language
// combo, and вопрос 99 made it untrue — the language now takes effect at once. The row is gone
// from all fourteen tables and the number stays a hole, like 3017..3021, 3023, 3024 and 3056
// below: a string identifier that moved would change what an installed build shows. A hole
// costs nothing here — `settings::string_from` walks a block of sixteen by index and an empty
// row is not a defect; the sweeps of completeness walk `INTERFACE_STRINGS`, which no longer
// names it.
#define IDS_GROUP_HOTKEY        3005
#define IDS_HOTKEY_LABEL        3006
#define IDS_HOTKEY_SET          3007
#define IDS_HOTKEY_STOP         3008
#define IDS_GROUP_LAYOUTS       3009
#define IDS_MODE_PAIR           3010
#define IDS_MODE_CYCLE          3011
#define IDS_PAIR_SOURCE         3012
#define IDS_PAIR_TARGET         3013
#define IDS_CYCLE_HINT          3014
#define IDS_CYCLE_UP            3015
#define IDS_CYCLE_DOWN          3016
// ⚠ **3017..3021, 3023, 3024 and 3056 are retired, not free** — task Т-23-2, решения 81 и
// 82. They were «Замена», «Backspace», «Выделение (совместимость)», «Задержка между
// событиями, мс:», «Выделение», «Таймаут буфера обмена, мс:», «Задержка восстановления,
// мс:» and «Автоматически (рекомендуется)»: the captions of the two groups that left the
// dialog. The rows are gone from both tables below and the holes stay — a string identifier
// that moved would change what an **installed** build shows, which is the same rule
// IDS_SOUND was numbered by. A new string takes a new number.
#define IDS_SELECTION_ENABLED   3022
#define IDS_GROUP_EXCLUSIONS    3025
#define IDS_EXCLUSION_REMOVE    3026
#define IDS_EXCLUSION_ADD       3027
#define IDS_EXCLUSION_HINT      3028
#define IDS_GROUP_DIAGNOSTICS   3029
#define IDS_LOG_ENABLED         3030
#define IDS_LOG_OPEN            3031
#define IDS_LOG_DIR_LABEL       3032
#define IDS_GROUP_STATE         3033
#define IDS_OK                  3034
#define IDS_CANCEL              3035
#define IDS_APPLY               3036
#define IDS_NOTE_TEXT_KEY       3037
#define IDS_NOTE_UNKNOWN_KEY    3038
#define IDS_CAPTURE_PROMPT      3039
#define IDS_CAPTURE_MODIFIER    3040
#define IDS_CAPTURE_COMBINATION 3041
#define IDS_CAPTURE_EMERGENCY   3042
#define IDS_CAPTURE_NAMELESS    3043
#define IDS_CAPTURE_RESERVED    3044
#define IDS_STATE_HOOK          3045
#define IDS_HOOK_UP             3046
#define IDS_HOOK_DOWN           3047
#define IDS_STATE_LAYOUTS       3048
#define IDS_STATE_AUTOSTART     3049
#define IDS_AUTOSTART_PRESENT   3050
#define IDS_AUTOSTART_ABSENT    3051
#define IDS_LAYOUT_NOTE         3052
#define IDS_LAYOUT_WORD_SOURCE  3053
#define IDS_LAYOUT_WORD_TARGET  3054
#define IDS_LOG_DIR_MISSING     3055
// 3056 was IDS_METHOD_AUTO, the third radio of the «Замена» group of FR-42а — retired by
// task Т-23-2 with the group; see the note at 3017 above. The number opened the block the
// four rows below stand in and the block is still opened by them, so nothing here moves.
// The appearance row of FR-92а, task T-11-3: the label and the three items of the combo
// box. They continue the sixteen-string block 3056 opened, contiguously, so no empty block
// appears. The order of the three items is a contract: the dialog adds them to the combo in
// exactly this order, and item index 0 is `system`, 1 is `light`, 2 is `dark`. Mirrored by
// hand in src\settings.rs, like every identifier of this file; check twice.
#define IDS_THEME_LABEL         3057
#define IDS_THEME_SYSTEM        3058
#define IDS_THEME_LIGHT         3059
#define IDS_THEME_DARK          3060

// FR-100, task Т-21-5 — the caption of the sound switch. The **number** is 3078, appended
// after the last one in use (IDS_MENU_EXIT), because a string identifier that moved would
// change what an installed build shows. The **definition** stands here, above the string
// tables that use it: rc.exe reads the script top to bottom and an identifier used before it
// is defined is `error RC2104`, measured.
#define IDS_SOUND               3078
// FR-94, task Т-23-5, решение 82.6 — the hint the capture shows under the field: «Esc или
// клик мимо — отмена». The **number** is 3079, appended after IDS_SOUND for the reason
// IDS_SOUND itself was appended, and it costs no new block: 3072..3087 is the block the menu
// already opened, and 3079 is inside it. The **definition** stands here for the same reason
// IDS_SOUND's does — above the tables that use it, or `error RC2104`.
#define IDS_CAPTURE_HINT        3079
// FR-90, task Т-31-4, решение 99.2 — the state of the **program** in the tooltip of the tray
// icon: «Lang Switcher — активна» / «Lang Switcher — приостановлена». Both words were Russian
// literals in `src\tray.rs`, past these tables, in all fourteen locales; neither Э28 nor Э30
// caught it, because the fitting stand measures windows and not the notification area. The
// **numbers** are 3080 and 3081, appended after the last one in use (IDS_CAPTURE_HINT), and they
// cost no new block: 3072..3087 is the block the menu opened. The **definitions** stand here for
// the reason IDS_SOUND's does — above the tables that use them, or `error RC2104`.
//
// ⚠ The gender is the **program**'s and not the keyboard hook's, so these two do not have to
// agree with IDS_HOOK_UP / IDS_HOOK_DOWN in the same window: there the subject is «перехват».
// The glossary of the stage writes the choice down per language
// (`scratchpad-Э31\глоссарий.md`, §1).
#define IDS_TIP_ACTIVE          3080
#define IDS_TIP_PAUSED          3081
// The about dialog of FR-92а, task T-11-11: the caption, the version line, the two
// description lines and its «ОК». They continue the sixteen-string block 3056 opened,
// contiguously — no gap, so no empty block between. «ОК» takes a row of its own rather
// than borrowing IDS_OK 3034: that row belongs to the settings dialog, and a shared row
// would make a rewording of one window silently reword the other. IDS_ABOUT_VERSION
// carries a {0}: the number is substituted by settings::format_text from the VERSIONINFO
// resource of the running executable, never spelled in this file twice. Mirrored by hand
// in src\settings.rs, like every identifier of this file; check twice.
#define IDS_ABOUT_CAPTION       3061
#define IDS_ABOUT_VERSION       3062
#define IDS_ABOUT_LINE_1        3063
#define IDS_ABOUT_LINE_2        3064
#define IDS_ABOUT_OK            3065
// The «Как пользоваться» panel of FR-92а — task Т-23-4, решение 82.5. Six rows: the caption
// of the panel and its five numbered lines. **3066..3071 and not 3079**, because those six
// numbers are the whole of what is left of the sixteen-string block 3056 opened and they are
// contiguous with the five above — a string put at 3079 would open a block of its own for six
// strings and leave ten empty rows behind it.
//
// ⚠ The first three carry a `{0}`: the **name of the hotkey**, substituted by
// `settings::format_text` out of `[hotkey] key` of the running configuration — the same field
// FR-92 shows in its own window. Never spelled here: a second copy of the key name is a second
// place for it to be wrong, and the whole point of решение 82.5 is that the help tells a person
// which key *their* program answers to.
#define IDS_ABOUT_HELP          3066
#define IDS_ABOUT_HELP_1        3067
#define IDS_ABOUT_HELP_2        3068
#define IDS_ABOUT_HELP_3        3069
#define IDS_ABOUT_HELP_4        3070
#define IDS_ABOUT_HELP_5        3071

// ---------------------------------------------------------------------------------------
// FR-101, FR-102 and FR-103 — the letters from the author. Task Т-32-2, вопрос 101.
// ---------------------------------------------------------------------------------------
//
// Fifty-eight identifiers continuing the block at 3082, contiguous with everything above it,
// and the canon of `settings::INTERFACE_STRINGS` grows from 73 to 131 with them.
//
// ⚠ **The three sentences of «Что нового» are per-delivery text and not permanent strings.**
// 3106..3108 say what changed in *this* build; the release check-list of `tools\release.ps1`
// reminds whoever cuts the next one to rewrite them in all fourteen tables. They are strings
// rather than a formatted list because a translation is a translation.
//
// ⚠ **The heart is «♥» (U+2665) and not the mock-up's «🖤» (U+1F5A4), and that is measured
// rather than preferred** — `scratchpad-Э32\глиф-сердце.log`. U+2665 is present in all three
// faces this program draws in (Segoe UI, Segoe UI Semibold); U+1F5A4 is outside the BMP, so
// `GetGlyphIndicesW` — the instrument of Э30 — **cannot answer for it at all**: it works over
// UTF-16 units and a surrogate is not a character. What would draw it is font linking to Segoe
// UI Emoji, a colour face, in a window that sets one ink for every row. ТЗ names this exact
// fallback: «нет глифа — «♥»».
#define IDS_LETTER_CAPTION      3082
#define IDS_CLOSE               3083
#define IDS_CHANNEL_OPEN        3084
#define IDS_SUPPORT_OPEN        3085
#define IDS_HELLO_TITLE         3086
