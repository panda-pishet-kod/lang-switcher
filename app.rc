    IDS_GROUP_HOTKEY        "Гаряча клавіша"
    IDS_HOTKEY_LABEL        "Клавіша:"
    IDS_HOTKEY_SET          "Задати"
    IDS_HOTKEY_STOP         "Скасувати"
    IDS_GROUP_LAYOUTS       "Розкладки"
