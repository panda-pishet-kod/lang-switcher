    IDS_WIZARD_REPEAT_SOMETIMES "a volte"
    IDS_WIZARD_REPEAT_ONCE  "una volta"
    IDS_WIZARD_IDEA_TITLE   "Descrivi l'idea"
    IDS_WIZARD_IDEA_NOTE    "Due domande. Più l'esempio è concreto, più è semplice capire che cosa fare esattamente."
    IDS_WIZARD_IDEA_WHAT    "Che cosa proponi?"
    IDS_WIZARD_IDEA_HELPS   "In che cosa aiuterebbe?"
    IDS_WIZARD_ATTACH_TITLE "Che cosa allegare?"
    IDS_WIZARD_ATTACH_NOTE  "Ogni voce si può togliere. Accanto è scritto che cosa finirà esattamente nel testo."
    IDS_WIZARD_ATTACH_MACHINE "Versione del programma e build di Windows"
    IDS_WIZARD_ATTACH_LAYOUTS "Layout nel sistema"
    IDS_WIZARD_ATTACH_SETTINGS "Impostazioni"
    IDS_WIZARD_ATTACH_JOURNAL "Registro del programma, dalla memoria"
    IDS_WIZARD_ATTACH_JOURNAL_SUB "{0} voci. Solo nomi di operazioni e codici di errore, nemmeno un tasto: è così che è fatto il registro"
    IDS_WIZARD_ATTACH_FOOT  "Non serve un file di registro: le voci stanno in memoria finché il programma è in esecuzione. Se il problema si ripete, accendi il registro nelle impostazioni e le voci sopravvivranno a un riavvio."
    IDS_WIZARD_PREVIEW_TITLE "Controlla e invia"
    IDS_WIZARD_PREVIEW_NOTE "Questo è tutto il testo del messaggio. Modifica quello che vuoi. Lo invii tu: il testo va negli appunti e il canale si apre nel browser."
    IDS_WIZARD_COPY         "Copia e apri il canale"
    IDS_WIZARD_SAVE         "Salva nella cartella del registro"
    IDS_WIZARD_COPIED_ONLY  "Copiato. L'indirizzo del canale arriverà nella prossima versione."
    IDS_WIZARD_COPIED       "Copiato, il canale è aperto."
    IDS_WIZARD_SAVED        "Salvato: {0}"
    IDS_WIZARD_FAILED       "Non ha funzionato. Il testo è rimasto nella finestra — copialo a mano."
    IDS_THANKYOU_BUG_TITLE  "Grazie per la segnalazione"
    IDS_THANKYOU_IDEA_TITLE "Grazie per l'idea"
    IDS_THANKYOU_BUG_TEXT   "Leggo ogni messaggio io stesso. Gli errori li riparo, e ciò che conta per tutti lo racconto in una lettera nel programma o nel canale. È bello che tu abbia trovato il tempo 🖤"
    IDS_THANKYOU_IDEA_TEXT  "Leggo ogni messaggio io stesso. Le idee vanno nel piano e le migliori le realizzo, e ciò che conta per tutti lo racconto in una lettera nel programma o nel canale. È bello che tu abbia trovato il tempo 🖤"
END

// ---------------------------------------------------------------------------------------
// Polish — `[general] language = "pl"`. LANG_POLISH 0x15.
// ---------------------------------------------------------------------------------------
//
// ⚠ Ogoneks and the crossed ł are the letters the code page decides: `ą ę ł ń ó ś ź ż`. The
// help lines are written impersonally («Słowo napisane…»), not in the second person singular,
// so that no string carries a grammatical gender for its reader.
LANGUAGE 0x15, 0x01
STRINGTABLE
BEGIN
    IDS_DIALOG_CAPTION      "Lang Switcher — ustawienia"
    IDS_GROUP_GENERAL       "Ogólne"
    IDS_AUTOSTART           "Uruchamiaj przy logowaniu"
    IDS_LANGUAGE_LABEL      "Język:"
    // ⚠ Т-28-4: «zadziała po ponownym uruchomieniu» rozpadało się na TRZY wiersze w polu
    // dwuwierszowym (51 px potrzeba, 38 px jest). Krótsze zdanie mieści się w dwóch.
    IDS_GROUP_HOTKEY        "Skrót klawiszowy"
    IDS_HOTKEY_LABEL        "Klawisz:"
    IDS_HOTKEY_SET          "Ustaw"
    IDS_HOTKEY_STOP         "Anuluj"
    IDS_GROUP_LAYOUTS       "Układy"
    IDS_MODE_PAIR           "Para"
    IDS_MODE_CYCLE          "Kilka układów"
    IDS_PAIR_SOURCE         "Źródło:"
    IDS_PAIR_TARGET         "Cel:"
    IDS_CYCLE_HINT          "Cykl: znacznik — udział, przyciski — kolejność"
    IDS_CYCLE_UP            "W górę"
    IDS_CYCLE_DOWN          "W dół"
    IDS_SELECTION_ENABLED   "Konwertuj zaznaczony tekst"
    IDS_GROUP_EXCLUSIONS    "Wyjątki"
    IDS_EXCLUSION_REMOVE    "Usuń"
    IDS_EXCLUSION_ADD       "Dodaj"
    IDS_EXCLUSION_HINT      "Nazwa procesu, na przykład game.exe"
    IDS_GROUP_DIAGNOSTICS   "Diagnostyka"
    IDS_LOG_ENABLED         "Prowadź dziennik"
