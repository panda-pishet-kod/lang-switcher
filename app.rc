// Resource script for Lang_Switcher: tray icons, the manifest and VERSIONINFO.
//
// Deliberately uses no #include <windows.h>: rc.exe is driven by embed-resource, which
// does not necessarily export the SDK include paths. Every constant is spelled out
// numerically so the script compiles regardless of how the include environment is set up.
//
//   24 = RT_MANIFEST
//   0x00040004 = VOS_NT_WINDOWS32
//   0x1 = VFT_APP
//   0x0 = VFT2_UNKNOWN
//   0x409 = US English, 1200 = Unicode code page

// This file is UTF-8 and says so explicitly. LegalCopyright carries the U+00A9 sign
// required by decision 8 of DECISIONS.md, which makes the script non-ASCII, and rc.exe
// with no declaration reads a .rc in the system ANSI code page, cp1251 on this machine.
// The two UTF-8 bytes C2 A9 are then taken for two cp1251 characters and the file
// properties end up reading "Copyright <U+0412><U+00A9> 2026 ...". Measured during task
// T-01-1a, not assumed. Like every trap of TOOLCHAIN.md section 8, it costs nothing at
// build time: the build succeeds, the resource is present, only its content is wrong.
//
// Declared by pragma rather than by a byte order mark, because the pragma is visible in
// the text. A BOM is invisible in an editor, and any tool that rewrites the file without
// preserving it silently brings the defect back; this line survives as ordinary content.
// Same reasoning as the #define below: this script states its assumptions instead of
// inheriting them from the environment it happens to be compiled in.
#pragma code_page(65001)

// VS_VERSION_INFO is a macro from windows.h, and its value is 1. Without this define
// rc.exe reads the bare word as a resource NAME rather than an ID, and quietly emits the
// version block under a string name. Nothing errors: the build succeeds, the resource is
// present, and GetFileVersionInfo returns nothing at all, because it looks up RT_VERSION
// strictly by ID 1. File properties come up empty and there is no error message anywhere.
// TOOLCHAIN.md section 8.3, measured during task H-9.
#define VS_VERSION_INFO 1

#define IDI_APP_ACTIVE  101
#define IDI_APP_PAUSED  102
// FR-90's third state, task Т-32-4: the same two icons carrying the dot of FR-101, "there is
// an unread letter". Two files and not one, because the state of the program and the state of
// the letters are independent — a person can pause the program with a letter unread.
#define IDI_APP_ACTIVE_UNREAD  103
#define IDI_APP_PAUSED_UNREAD  104
// FR-90, task T-86-2 (решения 144е и 145.1): the same four states WITHOUT the plate — the set
// the tray shows while the taskbar of Windows is dark (SystemUsesLightTheme = 0), where the
// plate of the main set melted into the bar (finding 144б). Nothing but the tray takes them:
// the executable, the installer, the Start menu, the window headers and the balloon keep
// 101…104.
#define IDI_TRAY_DARK_ACTIVE  105
#define IDI_TRAY_DARK_PAUSED  106
#define IDI_TRAY_DARK_ACTIVE_UNREAD  107
#define IDI_TRAY_DARK_PAUSED_UNREAD  108

// The dialog identifiers stay distinct, so that a mismatched constant in the Rust source shows up
// as a missing resource rather than as the wrong window. 200 was the settings dialog of FR-92, a
// window of the shell since task T-120-20; 202, 203 and 204 were the letters, «Последние письма»
// and «От автора» — windows of the shell since tasks T-120-16 and T-120-17; 205 was the wizard
// of FR-104, a window of the shell since task T-120-19. No dialog template is left.


// FR-90: two visually distinct tray states, each icon carrying the 16/20/24/32 px frames.
// The paths are relative to this file, which sits next to Cargo.toml -- exactly the layout
// proven by the H-9 control build. rc.exe resolves paths inside .rc files in a non-obvious
// way and a wrong one shows up as a silently missing resource, not as an error.
IDI_APP_ACTIVE  ICON  "res/langswitcher-active.ico"
IDI_APP_PAUSED  ICON  "res/langswitcher-paused.ico"
IDI_APP_ACTIVE_UNREAD  ICON  "res/langswitcher-active-unread.ico"
IDI_APP_PAUSED_UNREAD  ICON  "res/langswitcher-paused-unread.ico"
// FR-90, task T-86-2: the darkbar set, drawn by the same generator (tools\make-icons.ps1) —
// the tray's icons on a dark taskbar, nineteen frames each like the four above.
IDI_TRAY_DARK_ACTIVE  ICON  "res/langswitcher-darkbar-active.ico"
IDI_TRAY_DARK_PAUSED  ICON  "res/langswitcher-darkbar-paused.ico"
IDI_TRAY_DARK_ACTIVE_UNREAD  ICON  "res/langswitcher-darkbar-active-unread.ico"
IDI_TRAY_DARK_PAUSED_UNREAD  ICON  "res/langswitcher-darkbar-paused-unread.ico"

// The manifest is chosen by a /d define passed from build.rs, NOT hard-wired.
//
// Windows grants an image carrying uiAccess="true" its privilege only through ShellExecute, and
// only when the machine trusts its signature AND it lies in %ProgramFiles%. CreateProcess refuses
// such an image with 740 in any folder, whatever its signature; ShellExecute refuses it with 8235
// when the signature is not trusted (build.rs lists the measured refusals). Wiring the uiAccess
// manifest in unconditionally would make `cargo test` fail before a single test runs, because
// the test harness is built from this same bin target -- measured during task H-9.
// LANGSW_UIACCESS is defined for the FULL Release image only; the Debug build and the BASE
// Release image (LANGSW_NO_UIACCESS=1, stage E91) take app-dev.manifest.
#ifdef LANGSW_UIACCESS
1 24 "app.manifest"
#else
1 24 "app-dev.manifest"
#endif

// Values fixed by decision 8 of DECISIONS.md.
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,8,0,0
  PRODUCTVERSION  1,8,0,0
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          0x00040004L
  FILETYPE        0x1L
  FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Panda Koder"
            VALUE "FileDescription",  "Lang Switcher"
            VALUE "FileVersion",      "1.8.0.0"
            VALUE "InternalName",     "LangSwitcher.exe"
            VALUE "LegalCopyright",   "Copyright © 2026 Panda Koder"
            VALUE "OriginalFilename", "LangSwitcher.exe"
            VALUE "ProductName",      "Lang Switcher"
            VALUE "ProductVersion",   "1.8.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// =======================================================================================
// FR-94 -- the interface strings, one string table per locale. Task T-08-2.
// =======================================================================================
//
// ⚠ **The code page again, and this is the file's sharpest case.** Both tables below are
// full of Cyrillic, and `rc.exe` with no declaration reads a .rc in the system ANSI code
// page — cp1251 on this machine — turning every Russian string into mojibake **with no error
// at build time and with green tests**. The `#pragma code_page(65001)` at the top of this
// file governs the whole of it, tables included, and it is repeated immediately below so
// that the declaration is visible from the strings it protects rather than eight hundred
// lines away. The pragma is idempotent; two of them cost nothing and the second one cannot
// be lost by an edit that moves the tables to a file of their own.
//
// The result is not taken on trust: `tests\settings.rs` reads both tables back out of the
// **built** `LangSwitcher.exe`, opened with `LOAD_LIBRARY_AS_DATAFILE`, and compares every
// string against a literal written out in the test — the technique task T-08-1 established
// for the dialog template (barrier §4.4 of STATE.md: `embed-resource` links resources into
// binary targets only, so a test cannot look for them in its own image).
#pragma code_page(65001)

// The two locales of FR-94 as language identifiers. Spelled numerically for the reason given
// at the top of this file — there is no `#include <windows.h>` here — and these are the
// values `winnt.h` gives: LANG_RUSSIAN 0x19 with SUBLANG_DEFAULT 0x01 is LANGID 0x0419, and
// LANG_ENGLISH 0x09 with SUBLANG_ENGLISH_US 0x01 is 0x0409. `settings::Language` carries the
// same two numbers and `FindResourceExW` is asked for one of them by name of the locale the
// configuration chose — never by the user's Windows UI language, which is not what section 7
// says the choice is.
//
// The `LANGUAGE` statement below applies to the resources that follow it, and there are none
// after the tables: the icons, the manifest, VERSIONINFO and the dialog template are all
// above this line and keep the language they were emitted with.

// Identifiers of the interface strings. The numbering starts at 3000, clear of the dialog
// (200) and of the control identifiers (1001–1080), and it is contiguous: a string table
// resource holds sixteen strings per block, so a gap costs a whole block of nothing.
//
// ⚠ Mirrored by hand in `src\settings.rs`, exactly as the control identifiers are, because a
// .rc file and a Rust file share no header. A mismatch is not silent: the string comes back
// empty, `report_non_critical("FindResourceExW")` records the refusal, and the test that
// reads the tables out of the built binary compares them against the identifiers the crate
// exports.
#define IDS_DIALOG_CAPTION      3000
#define IDS_GROUP_GENERAL       3001
#define IDS_AUTOSTART           3002
#define IDS_LANGUAGE_LABEL      3003
// ⚠ **3004 is retired, not free** — task Т-31-3, решение 99.4. It was IDS_LANGUAGE_RESTART,
// «вступит в силу после перезапуска»: решения 83 и 83а.2 put the sentence beside the language
// combo, and вопрос 99 made it untrue — the language now takes effect at once. The row is gone
// from all fourteen tables and the number stays a hole, like 3017..3021, 3023, 3024 and 3056
// below: a string identifier that moved would change what an installed build shows. A hole
// costs nothing here — `settings::string_from` walks a block of sixteen by index and an empty
// row is not a defect; the sweeps of completeness walk `INTERFACE_STRINGS`, which no longer
// names it.
#define IDS_GROUP_HOTKEY        3005
#define IDS_HOTKEY_LABEL        3006
#define IDS_HOTKEY_SET          3007
#define IDS_HOTKEY_STOP         3008
#define IDS_GROUP_LAYOUTS       3009
#define IDS_MODE_PAIR           3010
#define IDS_MODE_CYCLE          3011
#define IDS_PAIR_SOURCE         3012
#define IDS_PAIR_TARGET         3013
#define IDS_CYCLE_HINT          3014
#define IDS_CYCLE_UP            3015
#define IDS_CYCLE_DOWN          3016
