    IDS_ABOUT_CAPTION       "À propos"
    IDS_ABOUT_VERSION       "version {0}"
    IDS_ABOUT_LINE_1        "Corrige le texte tapé dans la mauvaise disposition."
    IDS_ABOUT_LINE_2        "La conversion tient en une touche."
    IDS_ABOUT_OK            "OK"
    IDS_ABOUT_HELP          "Comment s'en servir"
    IDS_ABOUT_HELP_1        "Mot tapé dans la mauvaise disposition — appuyez sur {0} : le mot est converti, la disposition change."
    IDS_ABOUT_HELP_2        "Appuyer de nouveau sur {0} rend le texte d'origine."
    IDS_ABOUT_HELP_3        "Sélectionnez du texte et appuyez sur {0} — la sélection est convertie."
