    IDS_WIZARD_CAPTURE_COUNT "Passa alla finestra che ti serve… {0}"
    IDS_WIZARD_WHERE_FIELD  "Campo di immissione"
    IDS_WIZARD_FIELD_NORMAL "Un normale campo di immissione"
    IDS_WIZARD_FIELD_PASSWORD "Un campo password"
    IDS_WIZARD_FIELD_PASSWORD_SUB "nei campi password il programma non lavora di proposito: i tasti lì non vengono ricordati"
