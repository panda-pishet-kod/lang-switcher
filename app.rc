    IDS_WIZARD_TYPED_IN     "Wort getippt im Layout"
    IDS_WIZARD_AND_PRESSED  "und gedrückt"
    IDS_WIZARD_EXPECTED     "Erwartet:"
    IDS_WIZARD_GOT          "Bekommen:"
    IDS_WIZARD_REPEAT       "Wiederholt es sich?"
    IDS_WIZARD_REPEAT_ALWAYS "jedes Mal"
    IDS_WIZARD_REPEAT_SOMETIMES "manchmal"
    IDS_WIZARD_REPEAT_ONCE  "einmal"
    IDS_WIZARD_IDEA_TITLE   "Beschreiben Sie die Idee"
    IDS_WIZARD_IDEA_NOTE    "Zwei Fragen. Je konkreter das Beispiel, desto leichter ist zu erkennen, was genau zu tun ist."
    IDS_WIZARD_IDEA_WHAT    "Was schlagen Sie vor?"
    IDS_WIZARD_IDEA_HELPS   "Wobei hilft das?"
    IDS_WIZARD_ATTACH_TITLE "Was anhängen?"
