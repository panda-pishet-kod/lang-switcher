    IDS_WIZARD_FAILED       "Es hat nicht geklappt. Der Text steht noch im Fenster — kopieren Sie ihn von Hand."
    IDS_THANKYOU_BUG_TITLE  "Danke für die Fehlermeldung"
    IDS_THANKYOU_IDEA_TITLE "Danke für die Idee"
    IDS_THANKYOU_BUG_TEXT   "Ich lese jede Meldung selbst. Fehler behebe ich, und worüber alle Bescheid wissen sollten, erzähle ich in einem Brief im Programm oder im Kanal. Schön, dass Sie sich die Zeit genommen haben 🖤"
    IDS_THANKYOU_IDEA_TEXT  "Ich lese jede Meldung selbst. Ideen kommen in den Plan und die besten davon setze ich um, und worüber alle Bescheid wissen sollten, erzähle ich in einem Brief im Programm oder im Kanal. Schön, dass Sie sich die Zeit genommen haben 🖤"
END

// ---------------------------------------------------------------------------------------
// French — `[general] language = "fr"`. LANG_FRENCH 0x0C.
// ---------------------------------------------------------------------------------------
//
// ⚠ French puts a space before `:` `;` `?` `!` — a **narrow no-break space** in typography, and
// an ordinary one here, because the labels are drawn by our own code and a no-break space
// would be one more character to get wrong in ten places. The space is deliberate, not a typo.
LANGUAGE 0x0C, 0x01
STRINGTABLE
BEGIN
    IDS_DIALOG_CAPTION      "Lang Switcher — paramètres"
    IDS_GROUP_GENERAL       "Général"
    IDS_AUTOSTART           "Démarrer à l'ouverture de session"
    IDS_LANGUAGE_LABEL      "Langue :"
    IDS_GROUP_HOTKEY        "Raccourci"
    IDS_HOTKEY_LABEL        "Touche :"
    IDS_HOTKEY_SET          "Définir"
    IDS_HOTKEY_STOP         "Annuler"
    IDS_GROUP_LAYOUTS       "Dispositions"
    IDS_MODE_PAIR           "Paire"
    IDS_MODE_CYCLE          "Plusieurs dispositions"
    IDS_PAIR_SOURCE         "Source :"
    IDS_PAIR_TARGET         "Cible :"
    IDS_CYCLE_HINT          "Cycle : la coche participe, les boutons ordonnent"
    IDS_CYCLE_UP            "Monter"
    IDS_CYCLE_DOWN          "Descendre"
    IDS_SELECTION_ENABLED   "Convertir le texte sélectionné"
    IDS_GROUP_EXCLUSIONS    "Exceptions"
    IDS_EXCLUSION_REMOVE    "Retirer"
    IDS_EXCLUSION_ADD       "Ajouter"
    IDS_EXCLUSION_HINT      "Nom du processus, par exemple game.exe"
    IDS_GROUP_DIAGNOSTICS   "Diagnostic"
    IDS_LOG_ENABLED         "Tenir un journal"
    // ⚠ Т-28-4: «Ouvrir le dossier du journal» demandait 160 px sur les 151 du bouton, et
    // «Dossier du journal :» 114 px sur les 105 de l'étiquette. Raccourcis, pas remis en page.
    IDS_LOG_OPEN            "Ouvrir le dossier"
    IDS_LOG_SAVE            "Enregistrer le journal"
    IDS_LOG_SAVE_FAILED     "Le journal n'a pas pu être enregistré."
    IDS_LOG_SAVED           "Journal enregistré"
    IDS_LOG_DIR_LABEL       "Dossier :"
    IDS_GROUP_STATE         "État"
    IDS_OK                  "OK"
    IDS_CANCEL              "Annuler"
    IDS_APPLY               "Appliquer"
    IDS_NOTE_TEXT_KEY       "C'est une touche de saisie : tant que le programme est actif, elle cesse d'écrire son caractère."
    IDS_NOTE_UNKNOWN_KEY    "Nom de touche non reconnu — la touche par défaut, Pause, s'applique."
    IDS_CAPTURE_PROMPT      "Appuyez sur une touche…"
    IDS_CAPTURE_MODIFIER    "Une touche de modification seule ne peut pas être un raccourci."
    IDS_CAPTURE_COMBINATION "Les combinaisons avec modificateurs ne sont pas prises en charge : le fichier ne garde qu'une touche."
    IDS_CAPTURE_EMERGENCY   "Ctrl+Alt+Shift+F12 est la sortie d'urgence ; elle ne s'attribue pas."
