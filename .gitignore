# Артефакты сборки.
# У автора каталог артефактов вынесен из дерева переменной CARGO_TARGET_DIR,
# но правило оставлено на случай сборки без неё — например, из чужого сеанса.
/target
**/target/

# Поставка без переменной LANGSW_ARTIFACTS: tools\release.ps1, build-installer.ps1 и
# make-cert.ps1 кладут подписанный образ, установщик и публичный сертификат сюда (этап Э89,
# решение 152.3).
/dist/

# Собственные папки машины для скриптов tools\ — переменные LANGSW_* (этап Э89, решение 152.3).
# Файл есть только на машине; его образец, отслеживаемый, — tools\local.example.ps1.
/tools/local.ps1

# Отладочные символы и бинарные результаты сборки.
*.pdb
*.exe
*.dll
*.lib
*.exp
*.res
installer/Output/

# ---------------------------------------------------------------------------
# Секреты. Эти правила существуют не для чистоты дерева, а как страховка.
# Закрытый ключ сертификата подписи по решению настроечного этапа вообще не покидает
# хранилище Cert:\CurrentUser\My и создан неэкспортируемым, то есть .pfx возникнуть
# не может в принципе. Правила ниже — второй рубеж на случай, если кто-то создаст
# сертификат иначе. Раздел 9 SETUP-BRIEF.md: сертификаты и закрытые ключи в репозиторий
# не попадают ни при каком условии.
# ---------------------------------------------------------------------------
*.pfx
*.p12
*.cer
*.crt
*.key
*.pem
*.snk

# Пользовательские файлы IDE.
*.user
.vs/
.vscode/settings.json
.idea/

# Windows.
Thumbs.db
desktop.ini

# Кадры приборов серийной съёмки. `tools\flicker-burst.ps1` контура кладёт снятые кадры
# каталогом `frames-<элемент>-<палитра>-<область>-<метка времени>` в корень ЭТОГО дерева.
# Правила тут не было, и шесть таких каталогов пролежали в корне незамеченными: пустые
# каталоги git не отслеживает, поэтому `git status` показывал «чисто», пока внутри не было
# файлов. Первый же сохранённый кадр вылез бы мусором посреди приёмки.
frames-*/

# Локальные разрешения сеанса Claude Code (решение 147б): файл живёт только на этой машине
# и в публичное дерево не входит; README его больше не перечисляет.
/.claude/settings.json
