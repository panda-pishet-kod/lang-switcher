// Resource script of LangSwitcherUpdate.exe, the updater of stage E104 (TZ E104 p. 13): the
// manifest and VERSIONINFO, and nothing else -- no icons, no strings, no dialogs: the updater has
// no window. build.rs links this file into the LangSwitcherUpdate target only, and app.rc into
// the program and the bench only; until E104 embed-resource linked app.rc into every binary of
// the crate, and the updater would have carried the uiAccess manifest of the program.
//
// The version is NOT written here: build.rs passes the three numbers of [package] version of
// Cargo.toml as LANGSW_VER_MAJOR, LANGSW_VER_MINOR and LANGSW_VER_PATCH, so the eleven places of
// the version rule (version-equals-delivery-number) stay eleven. The string table of the version
// block carries no version for the same reason; the fixed block is what the updater itself and
// Windows read.
#pragma code_page(65001)

// As in app.rc: without this define rc.exe reads the word as a resource NAME (TOOLCHAIN.md 8.3).
#define VS_VERSION_INFO 1

1 24 "updater.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     LANGSW_VER_MAJOR,LANGSW_VER_MINOR,LANGSW_VER_PATCH,0
  PRODUCTVERSION  LANGSW_VER_MAJOR,LANGSW_VER_MINOR,LANGSW_VER_PATCH,0
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          0x00040004L
  FILETYPE        0x1L
  FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Panda Koder"
            VALUE "FileDescription",  "Lang Switcher Update"
            VALUE "InternalName",     "LangSwitcherUpdate.exe"
            VALUE "LegalCopyright",   "Copyright © 2026 Panda Koder"
            VALUE "OriginalFilename", "LangSwitcherUpdate.exe"
            VALUE "ProductName",      "Lang Switcher"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
