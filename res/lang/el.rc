#pragma code_page(65001)
// res/lang/el.rc -- Greek, the strings of the interface for `[general] language = "el"`.
//
// Stage L10N, task T-L10N-2: the two string tables of this language -- the dialog block and the
// menu block -- moved here out of app.rc unchanged; app.rc includes this file, and the built
// RT_STRING resource stayed byte for byte what it was. The rules every table obeys stand in
// app.rc above the #include lines; where each string is seen and how much room it has is
// res/lang/context.tsv; tests/l10n.rs holds this file to en.rc.
//
// ⚠ In an .rc string a backslash is an escape -- one backslash is written as two -- and a double
// quote inside a string is written as two double quotes. The code page line above is this
// file's own: without it rc.exe reads the file in the ANSI code page, silently.

// ---------------------------------------------------------------------------------------
// Greek — `[general] language = "el"`. LANG_GREEK 0x08.
// ---------------------------------------------------------------------------------------
//
// ⚠ The only non-Latin, non-Cyrillic script of the twelve, and therefore the sharpest test of
// the code page: every letter here is two bytes in UTF-8 and one wrong reading turns the whole
// table into `Î•Î»…`. The tonos is written on the multisyllabic words that carry it and on no
// others; «OK» stays in Latin letters, which is what Greek Windows itself shows on the button.
LANGUAGE 0x08, 0x01
STRINGTABLE
BEGIN
    IDS_DIALOG_CAPTION      "Lang Switcher — ρυθμίσεις"
    IDS_GROUP_GENERAL       "Γενικά"
    IDS_AUTOSTART           "Εκκίνηση με τη σύνδεση"
    IDS_LANGUAGE_LABEL      "Γλώσσα:"
    IDS_GROUP_HOTKEY        "Συντόμευση"
    IDS_HOTKEY_LABEL        "Πλήκτρο:"
    IDS_HOTKEY_SET          "Ορισμός"
    IDS_HOTKEY_STOP         "Άκυρο"
    IDS_GROUP_LAYOUTS       "Διατάξεις"
    IDS_MODE_PAIR           "Ζεύγος"
    IDS_MODE_CYCLE          "Πολλές διατάξεις"
    IDS_PAIR_SOURCE         "Πηγή:"
    // ⚠ Т-28-4: «Προορισμός:» ζητούσε 42,9 μονάδες από τις 42,3 της ετικέτας. «Στόχος» είναι
    // η ίδια έννοια σε λιγότερα γράμματα, και το γλωσσάρι το κρατά και στη σημείωση παρακάτω.
    IDS_PAIR_TARGET         "Στόχος:"
    IDS_CYCLE_HINT          "Κύκλος: το τικ συμμετέχει, τα κουμπιά ορίζουν σειρά"
    IDS_CYCLE_UP            "Πάνω"
    IDS_CYCLE_DOWN          "Κάτω"
    IDS_SELECTION_ENABLED   "Μετατροπή επιλεγμένου κειμένου"
    IDS_GROUP_EXCLUSIONS    "Εξαιρέσεις"
    IDS_EXCLUSION_REMOVE    "Αφαίρεση"
    IDS_EXCLUSION_ADD       "Προσθήκη"
    IDS_EXCLUSION_HINT      "Όνομα διεργασίας, για παράδειγμα game.exe"
    IDS_EXCLUSION_AUTO      "Αυτόματα"
    IDS_EXCLUSION_MANUAL    "Χειροκίνητα"
    IDS_EXCLUSION_PICK      "Επιλογή παραθύρου προγράμματος"
