#pragma code_page(65001)
// res/lang/it.rc -- Italian, the strings of the interface for `[general] language = "it"`.
//
// Stage L10N, task T-L10N-2: the two string tables of this language -- the dialog block and the
// menu block -- moved here out of app.rc unchanged; app.rc includes this file, and the built
// RT_STRING resource stayed byte for byte what it was. The rules every table obeys stand in
// app.rc above the #include lines; where each string is seen and how much room it has is
// res/lang/context.tsv; tests/l10n.rs holds this file to en.rc.
//
// ⚠ In an .rc string a backslash is an escape -- one backslash is written as two -- and a double
// quote inside a string is written as two double quotes. The code page line above is this
// file's own: without it rc.exe reads the file in the ANSI code page, silently.

// ---------------------------------------------------------------------------------------
// Italian — `[general] language = "it"`. LANG_ITALIAN 0x10.
// ---------------------------------------------------------------------------------------
LANGUAGE 0x10, 0x01
STRINGTABLE
BEGIN
    IDS_DIALOG_CAPTION      "Lang Switcher — impostazioni"
    IDS_GROUP_GENERAL       "Generale"
    IDS_AUTOSTART           "Avvia all'accesso"
    IDS_LANGUAGE_LABEL      "Lingua:"
    IDS_GROUP_HOTKEY        "Scorciatoia"
    IDS_HOTKEY_LABEL        "Tasto:"
    IDS_HOTKEY_SET          "Imposta"
    IDS_HOTKEY_STOP         "Annulla"
    IDS_GROUP_LAYOUTS       "Layout"
    IDS_MODE_PAIR           "Coppia"
    IDS_MODE_CYCLE          "Più layout"
    // ⚠ Т-28-4: «Destinazione:» chiedeva 44,0 unità sulle 42,3 dell'etichetta. La coppia
    // diventa «Da:» / «A:» — l'idioma italiano per origine e destinazione, quello che usano le
    // finestre di copia del sistema, e due parole vere, non abbreviazioni. I sostantivi
    // «origine» e «destinazione» restano dove c'è spazio: dentro la nota del layout.
    IDS_PAIR_SOURCE         "Da:"
    IDS_PAIR_TARGET         "A:"
    IDS_CYCLE_HINT          "Ciclo: la spunta partecipa, i pulsanti ordinano"
    IDS_CYCLE_UP            "Su"
    IDS_CYCLE_DOWN          "Giù"
    IDS_SELECTION_ENABLED   "Converti il testo selezionato"
    IDS_GROUP_EXCLUSIONS    "Eccezioni"
    IDS_EXCLUSION_REMOVE    "Rimuovi"
    IDS_EXCLUSION_ADD       "Aggiungi"
    IDS_EXCLUSION_HINT      "Nome del processo, per esempio game.exe"
    IDS_EXCLUSION_AUTO      "Automaticamente"
    IDS_EXCLUSION_MANUAL    "Manualmente"
    IDS_EXCLUSION_PICK      "Scegli la finestra del programma"
    IDS_EXCLUSION_PICK_NOTE "Fai clic e passa al programma entro 5 secondi"
    IDS_EXCLUSION_PICK_COUNT "Passa al programma che ti serve… {0}"
    IDS_EXCLUSION_ADDED     "Aggiunto: {0}"
    IDS_EXCLUSION_ALREADY   "Già nell'elenco: {0}"
    IDS_EXCLUSION_NOT_PICKED "Nessuna finestra scelta"
    IDS_GROUP_DIAGNOSTICS   "Diagnostica"
    IDS_LOG_ENABLED         "Tenere un registro"
    // ⚠ Т-28-4: «Apri la cartella del registro» chiedeva 156 px sui 151 del pulsante, e
    // «Cartella del registro:» 119 px sui 105 dell'etichetta. Accorciati, non rimpaginati.
    IDS_LOG_OPEN            "Apri la cartella"
    IDS_LOG_SAVE            "Salva il registro"
    IDS_LOG_SAVE_FAILED     "Impossibile salvare il registro."
    IDS_LOG_SAVED           "Registro salvato"
    IDS_LOG_DIR_LABEL       "Cartella:"
    IDS_GROUP_STATE         "Stato"
    IDS_OK                  "OK"
    IDS_CANCEL              "Annulla"
    IDS_APPLY               "Applica"
    IDS_NOTE_TEXT_KEY       "È un tasto di scrittura: finché il programma è attivo smette di inserire il suo carattere."
    IDS_NOTE_UNKNOWN_KEY    "Nome del tasto non riconosciuto — vale il tasto predefinito, Pause."
    IDS_CAPTURE_PROMPT      "Tasto o combinazione…"
    IDS_CAPTURE_MODIFIER    "Ctrl e Alt solo insieme a un tasto; due volte, solo Shift."
    IDS_CAPTURE_EMERGENCY   "Ctrl+Alt+Shift+F12 è l'uscita di emergenza e non si assegna."
    IDS_CAPTURE_NAMELESS    "Questo tasto non ha un nome nel file delle impostazioni — scegline un altro."
    IDS_CAPTURE_RESERVED    "Il sistema occupa questo tasto — scegline un altro."
    IDS_CAPTURE_TYPING      "Questo tasto serve a digitare — scegline un altro."
    IDS_HOTKEY_HINT         "Un tasto, una combinazione con Ctrl, Alt, Shift o un doppio Shift."
    IDS_CAPTURE_COMBO_NOTE  "{0} senza {1} resta ai programmi."
    IDS_CAPTURE_SHIFT_AGAIN "Ancora Shift — doppia pressione; un tasto con Shift — combinazione."
    IDS_CAPTURE_DOUBLE_NOTE "Due pressioni di Shift di seguito. La digitazione normale con Shift non cambia."
    IDS_ALREADY_RUNNING     "Lang Switcher è già in esecuzione in questa sessione."
    IDS_STATE_WORKING       "In funzione"
    IDS_STATE_SUSPENDED     "In pausa"
    IDS_STATE_HOOK_ABSENT   "L'intercettazione della tastiera non è installata"
    IDS_STATE_DISABLED      "L'intercettazione è installata, ma l'elaborazione è disattivata: riavvia il programma"
    IDS_STATE_HEALTH        "rimozioni silenziose dell'intercettazione: {0} · errori di installazione: {1} · pressioni perse: {2}"
    IDS_STATE_PAIR          "Coppia attiva: {0} → {1}"
    IDS_STATE_CYCLE         "Ciclo attivo: {0}"
    IDS_STATE_PAIR_NONE     "Nessuna coppia attiva"
    IDS_STATE_NO_FAILURES   "nessun errore di selezione"
    IDS_STATE_FAILURES      "errori di selezione: {0}"
    IDS_STATE_JOINED        "{0} · {1}"
    IDS_STATE_LAYOUTS       "Layout nella sessione: {0} · eccezioni pubblicate: {1} · voci nel registro: {2}"
    IDS_STATE_AUTOSTART     "Avvio automatico nel registro (HKCU\\…\\Run): {0}"
    IDS_AUTOSTART_PRESENT   "sì, {0}"
    IDS_AUTOSTART_ABSENT    "no"
    IDS_LAYOUT_NOTE         "La sessione non ha il layout indicato nel file ({0}) — scegli di nuovo."
    IDS_LAYOUT_WORD_SOURCE  "origine"
    IDS_LAYOUT_WORD_TARGET  "destinazione"
    IDS_LOG_DIR_MISSING     "%APPDATA% non è impostato — non c'è dove scrivere il registro"
    IDS_THEME_LABEL         "Aspetto:"
    IDS_THEME_SYSTEM        "Come il sistema"
    IDS_THEME_LIGHT         "Chiaro"
    IDS_THEME_DARK          "Scuro"
    IDS_SOUND               "Risposta sonora"
    IDS_ABOUT_CAPTION       "Informazioni"
    IDS_ABOUT_VERSION       "versione {0}"
    IDS_ABOUT_LINE_1        "Corregge il testo digitato nel layout sbagliato."
    IDS_ABOUT_LINE_2        "La conversione costa un tasto."
    IDS_ABOUT_OK            "OK"
    IDS_ABOUT_HELP          "Come si usa"
    IDS_ABOUT_HELP_1        "Parola digitata nel layout sbagliato — premi {0}: la parola si converte e il layout cambia."
    IDS_ABOUT_HELP_2        "Premere {0} di nuovo riporta il testo originale."
    IDS_ABOUT_HELP_3        "Seleziona il testo e premi {0} — la selezione viene convertita (se l'opzione è attiva e Ctrl+C funziona)."
    IDS_ABOUT_HELP_4        "Sospensione, impostazioni e uscita sono nell'icona dell'area di notifica."
    IDS_ABOUT_HELP_5        "Cambiare tasto: Impostazioni → Scorciatoia."
    IDS_CAPTURE_HINT        "Esc o un clic fuori annulla"
    IDS_TIP_ACTIVE          "attivo"
    IDS_TIP_PAUSED          "sospeso"
    IDS_LETTER_CAPTION      "Una lettera dall'autore"
    IDS_CLOSE               "Chiudi"
    IDS_CHANNEL_OPEN        "Apri il canale"
    IDS_FEEDBACK_OPEN       "Apri GitHub Issues"
    IDS_SUPPORT_OPEN        "Sostieni l'autore"
    IDS_HELLO_TITLE         "Ciao! Mi chiamo Panda."
    IDS_HELLO_LEAD          "Ho fatto io Lang Switcher e sono contento che tu lo abbia installato. Il programma fa una cosa sola: ripara una parola digitata con il layout sbagliato. Ecco come appare:"
    IDS_HELLO_DEMO_CAP      "Hai digitato «caff[», premuto {0} e ottenuto «caffè», con il layout passato all'italiano. Ancora una volta — e torna com'era."
    IDS_HELLO_PANEL         "Tre cose per il primo giorno"
    IDS_HELLO_ROW_1         "{0} converte l'ultima parola digitata e cambia il layout. Funziona in qualsiasi finestra."
    IDS_HELLO_ROW_2         "Premi di nuovo {0}: la parola torna com'era, lettera per lettera."
    IDS_HELLO_ROW_3         "L'icona nell'area di notifica: pausa, impostazioni e «Informazioni», dove c'è la sezione «Come si usa»."
    IDS_HELLO_SETTINGS      "Apri le impostazioni"
    IDS_HELLO_OK            "Ho capito"
    IDS_THANKS_TITLE        "È passato un mese. Grazie!"
    IDS_THANKS_LEAD         "Ciao, è di nuovo Panda. Un mese fa hai installato Lang Switcher, e spero che ti trovi bene: ho messo molte energie perché il programma restasse leggero e funzionasse e basta."
    IDS_THANKS_PARA         "Se ti è piaciuto, raccontalo su GitHub Issues. Se qualcosa non va, scrivimi: anche le critiche contano — un problema si ripara solo quando qualcuno lo conosce. La procedura guidata è nel menu dell'icona, alla voce «Scrivi all'autore…»."
    IDS_SUPPORT_PANEL       "Sostieni l'autore"
    IDS_SUPPORT_TEXT        "Il programma è gratuito e resterà tale. Se vuoi dire grazie con un gesto, la pagina di sostegno propone alcuni modi. È bello che tu apprezzi il lavoro altrui ♥"
    IDS_THANKS_SNOOZE       "Ricordamelo tra una settimana"
    IDS_THANKS_FOOT         "Questa lettera viene mostrata una volta sola."
    IDS_WHATSNEW_TITLE      "Novità nella {0}"
    IDS_WHATSNEW_FROM       "avevi la {0} · aggiornato oggi"
    IDS_WHATSNEW_TODAY      "aggiornato oggi"
    IDS_WHATSNEW_PANEL      "Tre cambiamenti"
    IDS_WHATSNEW_1          "Il pannello «Stato» parla chiaro: in funzione / in pausa / intercettazione non installata / serve un riavvio — e mostra la coppia di layout attiva e gli errori di selezione."
    IDS_WHATSNEW_2          "Il pulsante «Salva il registro…» scrive il registro adesso; l'intestazione riporta l'ora della presa e se la sessione era ancora in corso."
    IDS_WHATSNEW_3          "Il registro è più affidabile: una scrittura fallita non rovina il file precedente, «Tenere un registro» vale subito in questa sessione, e il «Riprendi» in grigio dice perché è in grigio."
    IDS_WHATSNEW_FULL       "L'elenco completo dei cambiamenti è pubblicato nel canale."
    IDS_AUTHOR_CAPTION      "Dall'autore"
    IDS_AUTHOR_PANEL        "L'autore"
    IDS_AUTHOR_TEXT         "Il programma è fatto da una sola persona nel tempo libero. È gratuito e resterà tale. Se vuoi dire grazie con un gesto, la pagina di sostegno propone alcuni modi. È bello che tu apprezzi il lavoro altrui ♥"
    IDS_NEWS_PANEL          "Notizie e aggiornamenti"
    IDS_NEWS_ABOUT_FEED     "Una volta al giorno il programma legge un file di notizie dal sito dell'autore e non invia nulla su di te. Scarica da lì le nuove versioni e le installa da solo, dopo averne verificato la firma."
    IDS_NEWS_NEVER_READ     "Il flusso non è ancora stato letto."
    IDS_NEWS_READ_ON        "Flusso letto il {0}, la firma dell'autore è valida."
    IDS_NEWS_LATEST         "È installata la versione {0}, ed è l'ultima."
    IDS_NEWS_AVAILABLE      "È installata la versione {0}, è disponibile la {1}."
    IDS_NEWS_DOWNLOAD       "Apri la pagina di download"
    IDS_NEWS_LETTERS        "Ultime lettere"
    IDS_NEWS_FILE_ONLY      "Si disattiva nel file delle impostazioni: [letters] feed = false."
    IDS_NEWS_SWITCH         "Avvisami degli aggiornamenti e delle notizie dell'autore"
    IDS_NEWS_SWITCH_SUB     "Una volta al giorno il programma legge un file dal sito dell'autore. Questo interruttore disattiva le lettere e le notizie di quel file."
    IDS_FEEDBACK_PANEL      "Riscontro"
    IDS_FEEDBACK_TEXT       "Hai trovato un errore o hai un'idea? La procedura guidata compone il messaggio in cinque passi. Niente parte da solo: il testo finisce negli appunti, e a incollarlo sei tu."
    IDS_WRITE_TO_AUTHOR     "Scrivi all'autore…"
    IDS_LETTERS_CAPTION     "Ultime lettere"
    IDS_LETTERS_FOOT        "Vengono conservate le tre notizie più recenti. Quando ne arriva una quarta, la più vecchia se ne va, anche se non letta."
    IDS_LETTERS_OPEN        "Apri la lettera"
    IDS_NEWS_READ_BUTTON    "Letta"
    IDS_MENU_UNREAD         "Lettera non letta…"
    IDS_MENU_UPDATE         "Versione {0} disponibile…"
    IDS_TOAST_TITLE         "Una lettera dall'autore"
    IDS_TOAST_NEWS          "Panda ha una notizia per te. Fai clic per leggerla, ci vuole un minuto."
    IDS_TOAST_THANKS        "È passato un mese dall'installazione. Panda vuole dirti due parole. Fai clic per leggerle."
    IDS_TOAST_UPDATE_TITLE  "È uscita la versione {0}"
    IDS_TOAST_UPDATE        "Tre cambiamenti e un collegamento al download. Fai clic per leggere."
    IDS_TOAST_WHATSNEW      "Tre cambiamenti. Fai clic per leggere."
    IDS_ABOUT_AUTHOR        "Dall'autore…"
    IDS_ENTRY_UPDATE_MARK   "{0} · aggiornamento · hai la {1}"
    IDS_ENTRY_UNREAD_MARK   "{0} · non letta"
    IDS_ENTRY_READ_MARK     "{0} · letta"
    IDS_UPDATE_SUB          "hai la {0} · uscita il {1}"
    IDS_UPDATE_HOW          "Come aggiornare"
    IDS_UPDATE_STEP_1       "Premi «Apri la pagina di download»: lì c'è sempre l'ultima versione."
    IDS_UPDATE_STEP_2       "Scarica il file LangSwitcher-setup.exe ed eseguilo."
    IDS_UPDATE_STEP_3       "Il programma di installazione chiude il programma da solo, lo sostituisce e propone di riavviarlo. Le tue impostazioni restano."
    IDS_UPDATE_FOOT         "La riga «Versione {0} disponibile» resta nel menu dell'icona finché non aggiorni."
    IDS_NEWS_LETTER_TITLE   "Novità dall'autore"
    IDS_NEWS_LATER          "Più tardi"
    IDS_NEWS_OPEN_LINK      "Apri il collegamento"
    IDS_NEWS_FOOT           "«Letta» chiude la lettera per sempre. «Più tardi» o la crocetta: te lo ricordo fra una settimana e ancora fra due, poi resta solo il punto sull'icona."
    IDS_WIZARD_CAPTION      "Scrivere all'autore"
    IDS_WIZARD_STEP         "Passo {0} di {1}"
    IDS_WIZARD_CANCEL       "Annulla"
    IDS_WIZARD_BACK         "Indietro"
    IDS_WIZARD_NEXT         "Avanti"
    IDS_WIZARD_DONE         "Fine"
    IDS_WIZARD_WHAT_TITLE   "Che cosa è successo?"
    IDS_WIZARD_WHAT_NOTE    "Dalla risposta dipende che cosa chiederà l'assistente dopo."
    IDS_WIZARD_CARD_WRONG   "Il programma ha fatto la cosa sbagliata"
    IDS_WIZARD_CARD_WRONG_SUB "la parola è stata convertita male, mancano lettere, il layout non era quello giusto"
    IDS_WIZARD_CARD_NOTHING "Non è successo nulla"
    IDS_WIZARD_CARD_NOTHING_SUB "hai premuto il tasto e il testo è rimasto com'era"
    IDS_WIZARD_CARD_IDEA    "Vorrei proporre un miglioramento"
    IDS_WIZARD_CARD_IDEA_SUB "un'idea, un desiderio, una scomodità"
    IDS_WIZARD_WHERE_TITLE  "Dove è successo?"
    IDS_WIZARD_WHERE_NOTE   "Il comportamento dipende dalla finestra: una console, un browser e un editor ricevono il testo in modi diversi. Passa a quella finestra e l'assistente annota il nome del programma da solo."
    IDS_WIZARD_PROGRAM      "Programma:"
    IDS_WIZARD_CAPTURE      "Prendi dalla finestra attiva"
    IDS_WIZARD_CAPTURE_NOTE "Vengono presi il nome del processo e la classe della finestra. Il titolo della finestra no: spesso contiene il nome di un documento."
    IDS_WIZARD_CAPTURE_COUNT "Passa alla finestra che ti serve… {0}"
    IDS_WIZARD_WHERE_FIELD  "Campo di immissione"
    IDS_WIZARD_FIELD_NORMAL "Un normale campo di immissione"
    IDS_WIZARD_FIELD_PASSWORD "Un campo password"
    IDS_WIZARD_FIELD_PASSWORD_SUB "nei campi password il programma non lavora di proposito: i tasti lì non vengono ricordati"
    IDS_WIZARD_FIELD_UNKNOWN "Non lo so"
    IDS_WIZARD_DID_TITLE    "Che cosa stavi facendo?"
    IDS_WIZARD_DID_NOTE     "Scrivi un esempio invece del testo vero. Il programma non conserva i tasti, quindi nel messaggio finirà solo quello che scrivi qui."
    IDS_WIZARD_TYPED_IN     "Hai scritto una parola nel layout"
    IDS_WIZARD_AND_PRESSED  "e premuto"
    IDS_WIZARD_EXPECTED     "Ti aspettavi:"
    IDS_WIZARD_GOT          "Hai ottenuto:"
    IDS_WIZARD_REPEAT       "Si ripete?"
    IDS_WIZARD_REPEAT_ALWAYS "ogni volta"
    IDS_WIZARD_REPEAT_SOMETIMES "a volte"
    IDS_WIZARD_REPEAT_ONCE  "una volta"
    IDS_WIZARD_IDEA_TITLE   "Descrivi l'idea"
    IDS_WIZARD_IDEA_NOTE    "Due domande. Più l'esempio è concreto, più è semplice capire che cosa fare esattamente."
    IDS_WIZARD_IDEA_WHAT    "Che cosa proponi?"
    IDS_WIZARD_IDEA_HELPS   "In che cosa aiuterebbe?"
    IDS_WIZARD_ATTACH_TITLE "Che cosa allegare?"
    IDS_WIZARD_ATTACH_NOTE  "Ogni voce si può togliere. Accanto è scritto che cosa finirà esattamente nel testo."
    IDS_WIZARD_ATTACH_MACHINE "Versione del programma e build di Windows"
    IDS_WIZARD_ATTACH_LAYOUTS "Layout nel sistema"
    IDS_WIZARD_ATTACH_SETTINGS "Impostazioni"
    IDS_WIZARD_ATTACH_JOURNAL "Registro del programma, dalla memoria"
    IDS_WIZARD_ATTACH_JOURNAL_SUB "Voci nel registro: {0}. Solo nomi di operazioni e codici di errore, nemmeno un tasto: è così che è fatto il registro"
    IDS_WIZARD_ATTACH_FOOT  "Non serve un file di registro: le voci stanno in memoria finché il programma è in esecuzione. Se il problema si ripete, accendi il registro nelle impostazioni e le voci sopravvivranno a un riavvio."
    IDS_WIZARD_PREVIEW_TITLE "Controlla e invia"
    IDS_WIZARD_PREVIEW_NOTE "Questo è tutto il testo del messaggio. Modifica quello che vuoi. Arriva all'autore solo quando premi «Invia»."
    IDS_WIZARD_SAVE         "Salva nella cartella del registro"
    IDS_WIZARD_MAIL_ADDRESS "Indirizzo e-mail: {0}"
    IDS_WIZARD_COPY_TEXT    "Copia il testo"
    IDS_WIZARD_COPY_ADDRESS "Copia l'indirizzo"
    IDS_WIZARD_TEXT_COPIED  "Testo copiato. Incollalo in un'e-mail a {0}."
    IDS_WIZARD_ADDRESS_COPIED "Indirizzo copiato: {0}."
    IDS_TOAST_UPDATED_TITLE "Lang Switcher è stato aggiornato alla {0}"
    IDS_TOAST_UPDATED       "Fai clic per scoprire le novità."
    IDS_WIZARD_SAVED        "Salvato: {0}"
    IDS_WIZARD_FAILED       "Non ha funzionato. Il testo è rimasto nella finestra — copialo a mano."
    IDS_LIST_SEPARATOR      ", "
    IDS_CYCLE_ARROW         " → "
    IDS_TIP_FORMAT          "{0} — {1}"
    IDS_WIZARD_SEND         "Invia"
    IDS_WIZARD_SENDING      "Invio…"
    IDS_WIZARD_RETRY        "Riprova"
    IDS_WIZARD_CONTACT      "Come contattarti — e-mail o Telegram, facoltativo, se servisse un chiarimento"
    IDS_WIZARD_CONTACT_LINE "Contatto:"
    IDS_WIZARD_FAILED_TITLE "Invio non riuscito"
    IDS_WIZARD_FAILED_NOTE  "Il sito dell'autore non ha risposto. Controlla la connessione e premi «Riprova», oppure invialo per e-mail: copia il testo e l'indirizzo."
    IDS_WIZARD_SENT_TITLE   "Messaggio inviato"
    IDS_WIZARD_SENT_TEXT    "Grazie per aver inviato il messaggio! Sono contento che partecipi alla vita del progetto, e leggerò sicuramente tutto nel mio tempo libero."
END

LANGUAGE 0x10, 0x01
STRINGTABLE
BEGIN
    IDS_MENU_SUSPEND        "Sospendi"
    IDS_MENU_RESUME         "Riprendi"
    IDS_MENU_RESUME_RESTART "Riprendi — serve un riavvio"
    IDS_MENU_SETTINGS       "Impostazioni…"
    IDS_MENU_AUTOSTART      "Avvia all'accesso"
    IDS_MENU_ABOUT          "Informazioni"
    IDS_MENU_EXIT           "Esci"
END
