    IDS_STATE_CYCLE         "Aktiver Zyklus: {0}"
    IDS_STATE_PAIR_NONE     "Kein aktives Paar"
    IDS_STATE_NO_FAILURES   "keine Auswahlfehler"
    IDS_STATE_FAILURES      "Auswahlfehler: {0}"
    IDS_STATE_JOINED        "{0} · {1}"
    IDS_STATE_LAYOUTS       "Layouts in der Sitzung: {0} · Ausnahmen veröffentlicht: {1} · Protokolleinträge: {2}"
    IDS_STATE_AUTOSTART     "Autostart in der Registrierung (HKCU\\…\\Run): {0}"
    IDS_AUTOSTART_PRESENT   "ja, {0}"
    IDS_AUTOSTART_ABSENT    "nein"
