    IDS_THEME_LIGHT         "Hell"
    IDS_THEME_DARK          "Dunkel"
    IDS_SOUND               "Tonrückmeldung"
    IDS_ABOUT_CAPTION       "Über"
    IDS_ABOUT_VERSION       "Version {0}"
    IDS_ABOUT_LINE_1        "Korrigiert Text, der im falschen Layout getippt wurde."
    IDS_ABOUT_LINE_2        "Die Umwandlung kostet einen Tastendruck."
    IDS_ABOUT_OK            "OK"
    IDS_ABOUT_HELP          "So wird es benutzt"
    IDS_ABOUT_HELP_1        "Wort im falschen Layout getippt — {0} drücken: das Wort wird umgewandelt, das Layout wechselt."
    IDS_ABOUT_HELP_2        "Noch einmal {0} holt den ursprünglichen Text zurück."
    IDS_ABOUT_HELP_3        "Text markieren und {0} drücken — die Markierung wird umgewandelt (falls aktiviert und Ctrl+C funktioniert)."
    IDS_ABOUT_HELP_4        "Anhalten, Einstellungen und Beenden sind im Infobereichssymbol."
    IDS_ABOUT_HELP_5        "Taste ändern: Einstellungen → Tastenkürzel."
    IDS_CAPTURE_HINT        "Esc oder ein Klick daneben bricht ab"
    IDS_TIP_ACTIVE          "aktiv"
    IDS_TIP_PAUSED          "angehalten"
    IDS_LETTER_CAPTION      "Ein Brief vom Autor"
    IDS_CLOSE               "Schließen"
    IDS_CHANNEL_OPEN        "Kanal öffnen"
    IDS_FEEDBACK_OPEN       "GitHub Issues öffnen"
    IDS_SUPPORT_OPEN        "Den Autor unterstützen"
    IDS_HELLO_TITLE         "Hallo! Ich heiße Panda."
    IDS_HELLO_LEAD          "Ich habe Lang Switcher gemacht und freue mich, dass Sie es installiert haben. Das Programm macht eine Sache: Es repariert ein Wort, das im falschen Tastaturlayout getippt wurde. So sieht das aus:"
    IDS_HELLO_DEMO_CAP      "Sie tippten «Gr[-e», drückten {0} und bekamen «Grüße», das Layout wechselte zu Deutsch. Noch einmal — und es ist wieder wie vorher."
    IDS_HELLO_PANEL         "Drei Dinge für den ersten Tag"
    IDS_HELLO_ROW_1         "{0} wandelt das zuletzt getippte Wort um und wechselt das Layout. Das funktioniert in jedem Fenster."
    IDS_HELLO_ROW_2         "Noch einmal {0}: Das Wort kommt Buchstabe für Buchstabe zurück."
    IDS_HELLO_ROW_3         "Das Symbol im Infobereich: Pause, Einstellungen und «Über», wo es den Abschnitt «Bedienung» gibt."
    IDS_HELLO_SETTINGS      "Einstellungen öffnen"
    IDS_HELLO_OK            "Verstanden"
    IDS_THANKS_TITLE        "Ein Monat ist vergangen. Danke!"
    IDS_THANKS_LEAD         "Hallo, hier ist wieder Panda. Vor einem Monat haben Sie Lang Switcher installiert, und ich hoffe, es ist bequem für Sie: Ich habe viel Mühe darauf verwendet, dass das Programm leicht ist und einfach funktioniert."
    IDS_THANKS_PARA         "Wenn es Ihnen gefallen hat, erzählen Sie davon in GitHub Issues. Wenn etwas nicht stimmt, schreiben Sie mir: Kritik ist genauso wichtig — ein Problem lässt sich erst beheben, wenn jemand davon weiß. Der Assistent steht im Menü des Symbols unter «An den Autor schreiben…»."
    IDS_SUPPORT_PANEL       "Den Autor unterstützen"
    IDS_SUPPORT_TEXT        "Das Programm ist kostenlos und bleibt es. Wenn Sie sich mit einer Tat bedanken möchten, nennt die Unterstützungsseite einige Wege. Schön, dass Sie fremde Arbeit zu schätzen wissen ♥"
    IDS_THANKS_SNOOZE       "In einer Woche erinnern"
    IDS_THANKS_FOOT         "Dieser Brief wird einmal gezeigt."
    IDS_WHATSNEW_TITLE      "Was ist neu in {0}"
    IDS_WHATSNEW_FROM       "vorher {0} · heute aktualisiert"
    IDS_WHATSNEW_TODAY      "heute aktualisiert"
    IDS_WHATSNEW_PANEL      "Drei Änderungen"
    IDS_WHATSNEW_1          "Die Tafel „Status“ spricht Klartext: läuft / angehalten / Hook nicht installiert / Neustart nötig — und zeigt das aktive Layoutpaar und die Auswahlfehler."
    IDS_WHATSNEW_2          "Die Schaltfläche „Protokoll speichern…“ schreibt das Protokoll sofort; sein Kopf trägt die Uhrzeit der Aufnahme und ob die Sitzung noch lief."
    IDS_WHATSNEW_3          "Das Protokoll ist verlässlicher: ein fehlgeschlagener Schreibvorgang beschädigt die vorige Datei nicht, „Protokoll führen“ wirkt sofort in dieser Sitzung, und das graue „Fortsetzen“ sagt, warum es grau ist."
    IDS_WHATSNEW_FULL       "Die vollständige Liste der Änderungen ist im Kanal veröffentlicht."
    IDS_AUTHOR_CAPTION      "Vom Autor"
    IDS_AUTHOR_PANEL        "Der Autor"
    IDS_AUTHOR_TEXT         "Das Programm macht ein einzelner Mensch in seiner Freizeit. Es ist kostenlos und bleibt es. Wenn Sie sich mit einer Tat bedanken möchten, nennt die Unterstützungsseite einige Wege. Schön, dass Sie fremde Arbeit zu schätzen wissen ♥"
    IDS_NEWS_PANEL          "Nachrichten und Updates"
    IDS_NEWS_ABOUT_FEED     "Einmal am Tag liest das Programm eine Nachrichtendatei von der Seite des Autors und sendet nichts über Sie. Neue Versionen lädt es von dort und installiert sie nach Prüfung der Signatur selbst."
    IDS_NEWS_NEVER_READ     "Der Feed wurde noch nicht gelesen."
    IDS_NEWS_READ_ON        "Feed am {0} gelesen, die Signatur des Autors stimmt."
    IDS_NEWS_LATEST         "Version {0} ist installiert, das ist die neueste."
    IDS_NEWS_AVAILABLE      "Version {0} ist installiert, {1} ist verfügbar."
    IDS_NEWS_DOWNLOAD       "Downloadseite öffnen"
    IDS_NEWS_LETTERS        "Letzte Briefe"
    IDS_NEWS_FILE_ONLY      "Abschaltbar in der Einstellungsdatei: [letters] feed = false."
    IDS_NEWS_SWITCH         "Über Updates und Neuigkeiten des Autors informieren"
    IDS_NEWS_SWITCH_SUB     "Einmal am Tag liest das Programm eine Datei von der Seite des Autors. Der Schalter schaltet die Briefe und Nachrichten aus dieser Datei ab."
    IDS_FEEDBACK_PANEL      "Rückmeldung"
    IDS_FEEDBACK_TEXT       "Einen Fehler gefunden oder eine Idee? Der Assistent stellt die Meldung zusammen und schickt sie erst an den Autor, wenn Sie auf «Senden» klicken."
    IDS_WRITE_TO_AUTHOR     "An den Autor schreiben…"
    IDS_LETTERS_CAPTION     "Letzte Briefe"
    IDS_LETTERS_FOOT        "Die drei letzten Nachrichten werden aufbewahrt. Kommt eine vierte, geht die älteste — auch ungelesen."
    IDS_LETTERS_OPEN        "Brief öffnen"
    IDS_NEWS_READ_BUTTON    "Gelesen"
    IDS_MENU_UNREAD         "Ungelesener Brief…"
    IDS_MENU_UPDATE         "Version {0} verfügbar…"
    IDS_TOAST_TITLE         "Ein Brief vom Autor"
    IDS_TOAST_NEWS          "Panda hat eine Neuigkeit für Sie. Klicken Sie, um sie zu lesen, das dauert eine Minute."
    IDS_TOAST_THANKS        "Seit der Installation ist ein Monat vergangen. Panda möchte ein paar Worte sagen. Klicken Sie, um sie zu lesen."
    IDS_TOAST_UPDATE_TITLE  "Version {0} ist da"
    IDS_TOAST_UPDATE        "Drei Änderungen und ein Link zum Download. Klicken Sie, um es zu lesen."
    IDS_TOAST_WHATSNEW      "Drei Änderungen. Klicken Sie, um sie zu lesen."
    IDS_ABOUT_AUTHOR        "Vom Autor…"
    IDS_ENTRY_UPDATE_MARK   "{0} · Update · Sie haben {1}"
    IDS_ENTRY_UNREAD_MARK   "{0} · ungelesen"
    IDS_ENTRY_READ_MARK     "{0} · gelesen"
    IDS_UPDATE_SUB          "Sie haben {0} · erschienen {1}"
    IDS_UPDATE_HOW          "So wird aktualisiert"
    IDS_UPDATE_STEP_1       "Klicken Sie auf «Downloadseite öffnen»: dort steht immer die neueste Version."
    IDS_UPDATE_STEP_2       "Laden Sie LangSwitcher-setup.exe herunter und starten Sie die Datei."
    IDS_UPDATE_STEP_3       "Das Installationsprogramm schließt das Programm selbst, ersetzt es und bietet an, es neu zu starten. Ihre Einstellungen bleiben erhalten."
    IDS_UPDATE_FOOT         "Der Eintrag «Version {0} verfügbar» bleibt im Symbolmenü, bis Sie aktualisieren."
    IDS_NEWS_LETTER_TITLE   "Neuigkeit vom Autor"
    IDS_NEWS_LATER          "Später"
    IDS_NEWS_OPEN_LINK      "Link öffnen"
    IDS_NEWS_FOOT           "«Gelesen» schließt den Brief endgültig. «Später» oder das Kreuz: ich erinnere in einer Woche und noch einmal in zwei, danach bleibt nur der Punkt am Symbol."
    IDS_WIZARD_CAPTION      "Dem Autor schreiben"
    IDS_WIZARD_STEP         "Schritt {0} von {1}"
    IDS_WIZARD_CANCEL       "Abbrechen"
    IDS_WIZARD_BACK         "Zurück"
    IDS_WIZARD_NEXT         "Weiter"
    IDS_WIZARD_DONE         "Fertig"
    IDS_WIZARD_WHAT_TITLE   "Was ist passiert?"
    IDS_WIZARD_WHAT_NOTE    "Von der Antwort hängt ab, wonach der Assistent als Nächstes fragt."
    IDS_WIZARD_CARD_WRONG   "Das Programm hat das Falsche getan"
    IDS_WIZARD_CARD_WRONG_SUB "das Wort wurde falsch umgesetzt, Buchstaben fehlen, das Layout war nicht das richtige"
    IDS_WIZARD_CARD_NOTHING "Es ist nichts passiert"
    IDS_WIZARD_CARD_NOTHING_SUB "Sie haben die Taste gedrückt, und der Text blieb, wie er war"
    IDS_WIZARD_CARD_IDEA    "Ich möchte eine Verbesserung vorschlagen"
    IDS_WIZARD_CARD_IDEA_SUB "eine Idee, ein Wunsch, etwas Unbequemes"
    IDS_WIZARD_WHERE_TITLE  "Wo ist es passiert?"
    IDS_WIZARD_WHERE_NOTE   "Das Verhalten hängt vom Fenster ab: Konsole, Browser und Editor nehmen Text unterschiedlich entgegen. Wechseln Sie in jenes Fenster, und der Assistent notiert den Programmnamen selbst."
    IDS_WIZARD_PROGRAM      "Programm:"
    IDS_WIZARD_CAPTURE      "Aus dem aktiven Fenster übernehmen"
    IDS_WIZARD_CAPTURE_NOTE "Übernommen werden Prozessname und Fensterklasse. Der Fenstertitel nicht: darin steht oft ein Dokumentname."
    IDS_WIZARD_CAPTURE_COUNT "Wechseln Sie in das gewünschte Fenster… {0}"
    IDS_WIZARD_WHERE_FIELD  "Eingabefeld"
    IDS_WIZARD_FIELD_NORMAL "Ein gewöhnliches Eingabefeld"
    IDS_WIZARD_FIELD_PASSWORD "Ein Kennwortfeld"
    IDS_WIZARD_FIELD_PASSWORD_SUB "in Kennwortfeldern arbeitet das Programm absichtlich nicht: Tastendrücke werden dort nicht gemerkt"
    IDS_WIZARD_FIELD_UNKNOWN "Ich weiß es nicht"
    IDS_WIZARD_DID_TITLE    "Was haben Sie getan?"
    IDS_WIZARD_DID_NOTE     "Schreiben Sie ein Beispiel statt des echten Textes. Das Programm speichert keine Tastendrücke, daher steht in der Meldung nur, was Sie hier schreiben."
    IDS_WIZARD_TYPED_IN     "Wort getippt im Layout"
    IDS_WIZARD_AND_PRESSED  "und gedrückt"
    IDS_WIZARD_EXPECTED     "Erwartet:"
    IDS_WIZARD_GOT          "Bekommen:"
    IDS_WIZARD_REPEAT       "Wiederholt es sich?"
    IDS_WIZARD_REPEAT_ALWAYS "jedes Mal"
    IDS_WIZARD_REPEAT_SOMETIMES "manchmal"
    IDS_WIZARD_REPEAT_ONCE  "einmal"
    IDS_WIZARD_IDEA_TITLE   "Beschreiben Sie die Idee"
    IDS_WIZARD_IDEA_NOTE    "Zwei Fragen. Je konkreter das Beispiel, desto leichter ist zu erkennen, was genau zu tun ist."
    IDS_WIZARD_IDEA_WHAT    "Was schlagen Sie vor?"
    IDS_WIZARD_IDEA_HELPS   "Wobei hilft das?"
    IDS_WIZARD_ATTACH_TITLE "Was anhängen?"
    IDS_WIZARD_ATTACH_NOTE  "Jeder Punkt kann abgewählt werden. Daneben steht, was genau in den Text kommt."
    IDS_WIZARD_ATTACH_MACHINE "Programmversion und Windows-Build"
    IDS_WIZARD_ATTACH_LAYOUTS "Layouts im System"
    IDS_WIZARD_ATTACH_SETTINGS "Einstellungen"
    IDS_WIZARD_ATTACH_JOURNAL "Programmjournal aus dem Speicher"
    IDS_WIZARD_ATTACH_JOURNAL_SUB "Einträge im Journal: {0}. Nur Namen von Operationen und Fehlercodes, keine einzige Taste: so ist das Journal gebaut"
    IDS_WIZARD_ATTACH_FOOT  "Eine Journaldatei ist nicht nötig: die Einträge liegen im Speicher, solange das Programm läuft. Wiederholt sich das Problem, schalten Sie das Journal in den Einstellungen ein, dann überleben die Einträge einen Neustart."
    IDS_WIZARD_PREVIEW_TITLE "Prüfen und senden"
    IDS_WIZARD_PREVIEW_NOTE "Das ist der ganze Text der Meldung. Ändern Sie, was Sie möchten. Er geht erst an den Autor, wenn Sie auf «Senden» klicken."
    IDS_WIZARD_SAVE         "In den Journalordner speichern"
    IDS_WIZARD_MAIL_ADDRESS "E-Mail-Adresse: {0}"
    IDS_WIZARD_COPY_TEXT    "Text kopieren"
    IDS_WIZARD_COPY_ADDRESS "Adresse kopieren"
    IDS_WIZARD_TEXT_COPIED  "Text kopiert. Fügen Sie ihn in eine E-Mail an {0} ein."
    IDS_WIZARD_ADDRESS_COPIED "Adresse kopiert: {0}."
    IDS_TOAST_UPDATED_TITLE "Lang Switcher wurde auf {0} aktualisiert"
    IDS_TOAST_UPDATED       "Klicken Sie, um zu sehen, was neu ist."
    IDS_WIZARD_SAVED        "Gespeichert: {0}"
    IDS_WIZARD_FAILED       "Es hat nicht geklappt. Der Text steht noch im Fenster — kopieren Sie ihn von Hand."
    IDS_LIST_SEPARATOR      ", "
    IDS_CYCLE_ARROW         " → "
    IDS_TIP_FORMAT          "{0} — {1}"
    IDS_WIZARD_SEND         "Senden"
    IDS_WIZARD_SENDING      "Wird gesendet…"
    IDS_WIZARD_RETRY        "Wiederholen"
    IDS_WIZARD_CONTACT      "So erreiche ich Sie — E-Mail oder Telegram, freiwillig, falls eine Rückfrage nötig ist"
    IDS_WIZARD_CONTACT_LINE "Kontakt:"
    IDS_WIZARD_FAILED_TITLE "Senden fehlgeschlagen"
    IDS_WIZARD_FAILED_NOTE  "Die Website des Autors hat nicht geantwortet. Prüfen Sie die Verbindung und klicken Sie auf «Wiederholen», oder senden Sie die Meldung per E-Mail: Kopieren Sie Text und Adresse."
    IDS_WIZARD_SENT_TITLE   "Meldung gesendet"
    IDS_WIZARD_SENT_TEXT    "Danke, dass Sie die Meldung geschickt haben! Ich freue mich, dass Sie sich am Leben des Projekts beteiligen, und lese bestimmt alles in meiner freien Zeit."
END

LANGUAGE 0x07, 0x01
STRINGTABLE
BEGIN
    IDS_MENU_SUSPEND        "Anhalten"
    IDS_MENU_RESUME         "Fortsetzen"
    IDS_MENU_RESUME_RESTART "Fortsetzen — Neustart nötig"
    IDS_MENU_SETTINGS       "Einstellungen…"
    IDS_MENU_AUTOSTART      "Beim Anmelden starten"
    IDS_MENU_ABOUT          "Über"
    IDS_MENU_EXIT           "Beenden"
END
