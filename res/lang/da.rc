#pragma code_page(65001)
// res/lang/da.rc -- Danish, the strings of the interface for `[general] language = "da"`.
//
// Stage E109 (group B), translator pass: the two string tables of this language -- the dialog
// block and the menu block -- in the order of en.rc. tests/l10n.rs holds this file to en.rc;
// where each string is seen and how much room it has is res/lang/context.tsv.
//
// ⚠ In an .rc string a backslash is an escape -- one backslash is written as two -- and a double
// quote inside a string is written as two double quotes. The code page line above is this
// file's own: without it rc.exe reads the file in the ANSI code page, silently.

// ---------------------------------------------------------------------------------------
// Danish — `[general] language = "da"`.
// ---------------------------------------------------------------------------------------
