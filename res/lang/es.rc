    IDS_LAYOUT_WORD_SOURCE  "origen"
    IDS_LAYOUT_WORD_TARGET  "destino"
    IDS_LOG_DIR_MISSING     "%APPDATA% no está definido — no hay dónde escribir el registro"
    IDS_THEME_LABEL         "Apariencia:"
    IDS_THEME_SYSTEM        "Como el sistema"
    IDS_THEME_LIGHT         "Claro"
    IDS_THEME_DARK          "Oscuro"
    IDS_SOUND               "Respuesta sonora"
    IDS_ABOUT_CAPTION       "Acerca de"
    IDS_ABOUT_VERSION       "versión {0}"
    IDS_ABOUT_LINE_1        "Corrige el texto escrito en la distribución equivocada."
    IDS_ABOUT_LINE_2        "La conversión cuesta una sola tecla."
    IDS_ABOUT_OK            "Aceptar"
    IDS_ABOUT_HELP          "Cómo se usa"
    IDS_ABOUT_HELP_1        "Escribió una palabra en la distribución equivocada — pulse {0}: la palabra se convierte y la distribución cambia."
    IDS_ABOUT_HELP_2        "Pulsar {0} de nuevo devuelve el texto original."
    IDS_ABOUT_HELP_3        "Seleccione texto y pulse {0} — se convierte lo seleccionado (si la opción está activada y Ctrl+C funciona)."
    IDS_ABOUT_HELP_4        "Pausa, configuración y salida están en el icono del área de notificación."
    IDS_ABOUT_HELP_5        "Cambiar la tecla: Configuración → Atajo."
    IDS_CAPTURE_HINT        "Esc o un clic fuera cancela"
    IDS_TIP_ACTIVE          "activo"
    IDS_TIP_PAUSED          "pausado"
    IDS_LETTER_CAPTION      "Una carta del autor"
    IDS_CLOSE               "Cerrar"
    IDS_CHANNEL_OPEN        "Abrir el canal"
    IDS_FEEDBACK_OPEN       "Abrir GitHub Issues"
    IDS_SUPPORT_OPEN        "Apoyar al autor"
    IDS_HELLO_TITLE         "¡Hola! Me llamo Panda."
    IDS_HELLO_LEAD          "Hice Lang Switcher y me alegra que lo haya instalado. El programa hace una sola cosa: arregla una palabra escrita en la distribución equivocada. Así se ve:"
    IDS_HELLO_DEMO_CAP      "Escribió «ma;ana», pulsó {0} y obtuvo «mañana», la distribución cambió a español. Otra vez — y todo vuelve como estaba."
    IDS_HELLO_PANEL         "Tres cosas para el primer día"
    IDS_HELLO_ROW_1         "{0} convierte la última palabra escrita y cambia la distribución. Funciona en cualquier ventana."
    IDS_HELLO_ROW_2         "Pulse {0} otra vez: la palabra vuelve a su forma original, letra por letra."
    IDS_HELLO_ROW_3         "El icono del área de notificación: pausa, ajustes y «Acerca de», que tiene la sección «Cómo usarlo»."
    IDS_HELLO_SETTINGS      "Abrir los ajustes"
    IDS_HELLO_OK            "Entendido"
    IDS_THANKS_TITLE        "Ha pasado un mes. ¡Gracias!"
    IDS_THANKS_LEAD         "Hola, soy Panda otra vez. Hace un mes instaló Lang Switcher, y espero que le resulte cómodo: puse mucho esfuerzo en que el programa fuera ligero y simplemente funcionara."
    IDS_THANKS_PARA         "Si le gustó, cuéntelo en GitHub Issues. Si algo no va bien, escríbame: la crítica también importa — un problema solo se arregla cuando alguien lo conoce. El asistente está en el menú del icono, en «Escribir al autor…»."
    IDS_SUPPORT_PANEL       "Apoyar al autor"
    IDS_SUPPORT_TEXT        "El programa es gratuito y seguirá siéndolo. Si quiere dar las gracias con un gesto, la página de apoyo ofrece varias formas. Está bien saber valorar el trabajo ajeno ♥"
    IDS_THANKS_SNOOZE       "Recordármelo en una semana"
    IDS_THANKS_FOOT         "Esta carta se muestra una sola vez."
    IDS_WHATSNEW_TITLE      "Novedades de {0}"
    IDS_WHATSNEW_FROM       "tenía {0} · actualizado hoy"
    IDS_WHATSNEW_TODAY      "actualizado hoy"
    IDS_WHATSNEW_PANEL      "Tres cambios"
    IDS_WHATSNEW_1          "El panel «Estado» habla claro: en marcha / en pausa / interceptación no instalada / hace falta reiniciar; y muestra el par de distribuciones activo y los fallos de selección."
    IDS_WHATSNEW_2          "El botón «Guardar el registro…» escribe el registro ahora; su cabecera lleva la hora de la toma e indica si la sesión seguía."
    IDS_WHATSNEW_3          "El registro es más fiable: una escritura fallida no daña el archivo anterior, «Llevar un registro» actúa al momento en esta sesión, y el «Reanudar» en gris dice por qué está en gris."
    IDS_WHATSNEW_FULL       "La lista completa de cambios está publicada en el canal."
    IDS_AUTHOR_CAPTION      "Del autor"
    IDS_AUTHOR_PANEL        "El autor"
    IDS_AUTHOR_TEXT         "El programa lo hace una sola persona en su tiempo libre. Es gratuito y seguirá siéndolo. Si quiere dar las gracias con un gesto, la página de apoyo ofrece varias formas. Está bien saber valorar el trabajo ajeno ♥"
    IDS_NEWS_PANEL          "Noticias y actualizaciones"
    IDS_NEWS_ABOUT_FEED     "Una vez al día el programa lee un archivo de noticias del sitio del autor y no envía nada sobre usted. Descarga de allí las versiones nuevas y las instala solo, tras comprobar la firma."
    IDS_NEWS_NEVER_READ     "El canal aún no se ha leído."
    IDS_NEWS_READ_ON        "Canal leído el {0}, la firma del autor es correcta."
    IDS_NEWS_LATEST         "Está instalada la versión {0}, y es la última."
    IDS_NEWS_AVAILABLE      "Está instalada la versión {0}, hay disponible la {1}."
    IDS_NEWS_DOWNLOAD       "Abrir la página de descarga"
    IDS_NEWS_LETTERS        "Últimas cartas"
    IDS_NEWS_FILE_ONLY      "Se desactiva en el archivo de ajustes: [letters] feed = false."
    IDS_NEWS_SWITCH         "Avisarme de las actualizaciones y noticias del autor"
    IDS_NEWS_SWITCH_SUB     "Una vez al día el programa lee un archivo del sitio del autor. Este interruptor desactiva las cartas y las noticias de ese archivo."
    IDS_FEEDBACK_PANEL      "Comentarios"
    IDS_FEEDBACK_TEXT       "¿Encontró un error o tiene una idea? El asistente compone el mensaje y solo lo envía al autor cuando pulse «Enviar»."
    IDS_WRITE_TO_AUTHOR     "Escribir al autor…"
    IDS_LETTERS_CAPTION     "Últimas cartas"
    IDS_LETTERS_FOOT        "Se guardan las tres últimas noticias. Cuando llega una cuarta, la más antigua se va, aunque no se haya leído."
    IDS_LETTERS_OPEN        "Abrir la carta"
    IDS_NEWS_READ_BUTTON    "Leída"
    IDS_MENU_UNREAD         "Carta sin leer…"
    IDS_MENU_UPDATE         "Versión {0} disponible…"
    IDS_TOAST_TITLE         "Una carta del autor"
    IDS_TOAST_NEWS          "Panda tiene una noticia para usted. Pulse para leerla, le llevará un minuto."
    IDS_TOAST_THANKS        "Ha pasado un mes desde la instalación. Panda quiere decirle un par de cosas. Pulse para leerlas."
    IDS_TOAST_UPDATE_TITLE  "Ha salido la versión {0}"
    IDS_TOAST_UPDATE        "Tres cambios y un enlace de descarga. Pulse para leerlo."
    IDS_TOAST_WHATSNEW      "Tres cambios. Pulse para leerlos."
    IDS_ABOUT_AUTHOR        "Del autor…"
    IDS_ENTRY_UPDATE_MARK   "{0} · actualización · usted tiene la {1}"
    IDS_ENTRY_UNREAD_MARK   "{0} · sin leer"
    IDS_ENTRY_READ_MARK     "{0} · leída"
    IDS_UPDATE_SUB          "usted tiene la {0} · publicada el {1}"
    IDS_UPDATE_HOW          "Cómo actualizar"
    IDS_UPDATE_STEP_1       "Pulse «Abrir la página de descarga»: allí siempre está la última versión."
    IDS_UPDATE_STEP_2       "Descargue el archivo LangSwitcher-setup.exe y ejecútelo."
    IDS_UPDATE_STEP_3       "El instalador cierra el programa por su cuenta, lo sustituye y ofrece iniciarlo de nuevo. Sus ajustes se conservan."
    IDS_UPDATE_FOOT         "La línea «Versión {0} disponible» permanece en el menú del icono hasta que actualice."
    IDS_NEWS_LETTER_TITLE   "Noticia del autor"
    IDS_NEWS_LATER          "Más tarde"
    IDS_NEWS_OPEN_LINK      "Abrir el enlace"
    IDS_NEWS_FOOT           "«Leída» cierra la carta para siempre. «Más tarde» o la cruz: le recuerdo en una semana y otra vez en dos, después solo queda el punto en el icono."
    IDS_WIZARD_CAPTION      "Escribir al autor"
    IDS_WIZARD_STEP         "Paso {0} de {1}"
    IDS_WIZARD_CANCEL       "Cancelar"
    IDS_WIZARD_BACK         "Atrás"
    IDS_WIZARD_NEXT         "Siguiente"
    IDS_WIZARD_DONE         "Listo"
    IDS_WIZARD_WHAT_TITLE   "¿Qué ha pasado?"
    IDS_WIZARD_WHAT_NOTE    "De la respuesta depende lo que el asistente preguntará después."
    IDS_WIZARD_CARD_WRONG   "El programa hizo algo distinto"
    IDS_WIZARD_CARD_WRONG_SUB "la palabra se convirtió mal, faltan letras, la distribución no era la correcta"
    IDS_WIZARD_CARD_NOTHING "No pasó nada"
    IDS_WIZARD_CARD_NOTHING_SUB "pulsó la tecla y el texto quedó como estaba"
    IDS_WIZARD_CARD_IDEA    "Quiero proponer una mejora"
    IDS_WIZARD_CARD_IDEA_SUB "una idea, un deseo, una incomodidad"
    IDS_WIZARD_WHERE_TITLE  "¿Dónde ocurrió?"
    IDS_WIZARD_WHERE_NOTE   "El comportamiento depende de la ventana: una consola, un navegador y un editor reciben el texto de maneras distintas. Cambie a esa ventana y el asistente anotará el nombre del programa por su cuenta."
    IDS_WIZARD_PROGRAM      "Programa:"
    IDS_WIZARD_CAPTURE      "Tomar de la ventana activa"
    IDS_WIZARD_CAPTURE_NOTE "Se toman el nombre del proceso y la clase de la ventana. El título de la ventana no: suele llevar el nombre de un documento."
    IDS_WIZARD_CAPTURE_COUNT "Cambie a la ventana que necesita… {0}"
    IDS_WIZARD_WHERE_FIELD  "Campo de entrada"
    IDS_WIZARD_FIELD_NORMAL "Un campo de entrada normal"
    IDS_WIZARD_FIELD_PASSWORD "Un campo de contraseña"
    IDS_WIZARD_FIELD_PASSWORD_SUB "en los campos de contraseña el programa no trabaja a propósito: allí las pulsaciones no se recuerdan"
    IDS_WIZARD_FIELD_UNKNOWN "No lo sé"
    IDS_WIZARD_DID_TITLE    "¿Qué estaba haciendo?"
    IDS_WIZARD_DID_NOTE     "Escriba un ejemplo en lugar del texto real. El programa no guarda pulsaciones, así que en el mensaje solo irá lo que escriba aquí."
    IDS_WIZARD_TYPED_IN     "Escribió una palabra en la distribución"
    IDS_WIZARD_AND_PRESSED  "y pulsó"
    IDS_WIZARD_EXPECTED     "Esperaba:"
    IDS_WIZARD_GOT          "Obtuvo:"
    IDS_WIZARD_REPEAT       "¿Se repite?"
    IDS_WIZARD_REPEAT_ALWAYS "cada vez"
    IDS_WIZARD_REPEAT_SOMETIMES "a veces"
    IDS_WIZARD_REPEAT_ONCE  "una vez"
    IDS_WIZARD_IDEA_TITLE   "Describa la idea"
    IDS_WIZARD_IDEA_NOTE    "Dos preguntas. Cuanto más concreto el ejemplo, más fácil es ver qué hacer exactamente."
    IDS_WIZARD_IDEA_WHAT    "¿Qué propone?"
    IDS_WIZARD_IDEA_HELPS   "¿En qué ayudaría?"
    IDS_WIZARD_ATTACH_TITLE "¿Qué adjuntar?"
    IDS_WIZARD_ATTACH_NOTE  "Cada punto se puede quitar. Al lado está escrito qué irá exactamente al texto."
    IDS_WIZARD_ATTACH_MACHINE "Versión del programa y compilación de Windows"
    IDS_WIZARD_ATTACH_LAYOUTS "Distribuciones del sistema"
    IDS_WIZARD_ATTACH_SETTINGS "Ajustes"
    IDS_WIZARD_ATTACH_JOURNAL "Registro del programa, desde la memoria"
    IDS_WIZARD_ATTACH_JOURNAL_SUB "Entradas del registro: {0}. Solo nombres de operaciones y códigos de error, ni una sola tecla: así está hecho el registro"
    IDS_WIZARD_ATTACH_FOOT  "No hace falta un archivo de registro: las entradas están en memoria mientras el programa se ejecuta. Si el problema se repite, active el registro en los ajustes y las entradas sobrevivirán a un reinicio."
    IDS_WIZARD_PREVIEW_TITLE "Revise y envíe"
    IDS_WIZARD_PREVIEW_NOTE "Este es todo el texto del mensaje. Edite lo que quiera. Solo llegará al autor cuando pulse «Enviar»."
    IDS_WIZARD_SAVE         "Guardar en la carpeta del registro"
    IDS_WIZARD_MAIL_ADDRESS "Dirección de correo: {0}"
    IDS_WIZARD_COPY_TEXT    "Copiar el texto"
    IDS_WIZARD_COPY_ADDRESS "Copiar la dirección"
    IDS_WIZARD_TEXT_COPIED  "Texto copiado. Péguelo en un correo a {0}."
    IDS_WIZARD_ADDRESS_COPIED "Dirección copiada: {0}."
    IDS_TOAST_UPDATED_TITLE "Lang Switcher se ha actualizado a la {0}"
    IDS_TOAST_UPDATED       "Pulse para ver las novedades."
    IDS_WIZARD_SAVED        "Guardado: {0}"
    IDS_WIZARD_FAILED       "No funcionó. El texto sigue en la ventana: cópielo a mano."
    IDS_LIST_SEPARATOR      ", "
    IDS_CYCLE_ARROW         " → "
    IDS_TIP_FORMAT          "{0} — {1}"
    IDS_WIZARD_SEND         "Enviar"
    IDS_WIZARD_SENDING      "Enviando…"
    IDS_WIZARD_RETRY        "Reintentar"
    IDS_WIZARD_CONTACT      "Cómo contactarle — correo o Telegram, opcional, por si hace falta aclarar algo"
    IDS_WIZARD_CONTACT_LINE "Contacto:"
    IDS_WIZARD_FAILED_TITLE "No se pudo enviar"
    IDS_WIZARD_FAILED_NOTE  "El sitio del autor no respondió. Compruebe la conexión y pulse «Reintentar», o envíelo por correo: copie el texto y la dirección."
    IDS_WIZARD_SENT_TITLE   "Mensaje enviado"
    IDS_WIZARD_SENT_TEXT    "¡Gracias por enviar el mensaje! Me alegra que participe en la vida del proyecto, y lo leeré todo sin falta en mi tiempo libre."
END

LANGUAGE 0x0A, 0x01
STRINGTABLE
BEGIN
    IDS_MENU_SUSPEND        "Pausar"
    IDS_MENU_RESUME         "Reanudar"
    IDS_MENU_RESUME_RESTART "Reanudar: hace falta reiniciar"
    IDS_MENU_SETTINGS       "Configuración…"
    IDS_MENU_AUTOSTART      "Iniciar al iniciar sesión"
    IDS_MENU_ABOUT          "Acerca de"
    IDS_MENU_EXIT           "Salir"
END
