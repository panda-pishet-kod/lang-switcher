    IDS_EXCLUSION_ADDED     "Añadido: {0}"
    IDS_EXCLUSION_ALREADY   "Ya está en la lista: {0}"
    IDS_EXCLUSION_NOT_PICKED "No se eligió ninguna ventana"
    IDS_GROUP_DIAGNOSTICS   "Diagnóstico"
    IDS_LOG_ENABLED         "Llevar un registro"
