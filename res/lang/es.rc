    // del registro:» 121 px de los 105 de la etiqueta. Acortados; la maquetación no se toca.
    IDS_LOG_OPEN            "Abrir la carpeta"
    IDS_LOG_SAVE            "Guardar el registro"
    IDS_LOG_SAVE_FAILED     "No se pudo guardar el registro."
    IDS_LOG_SAVED           "Registro guardado"
    IDS_LOG_DIR_LABEL       "Carpeta:"
    IDS_GROUP_STATE         "Estado"
    IDS_OK                  "Aceptar"
    IDS_CANCEL              "Cancelar"
    IDS_APPLY               "Aplicar"
    IDS_NOTE_TEXT_KEY       "Es una tecla de escritura: mientras el programa esté activo dejará de escribir su carácter."
    IDS_NOTE_UNKNOWN_KEY    "Nombre de tecla no reconocido — rige la tecla predeterminada, Pause."
    IDS_CAPTURE_PROMPT      "Tecla o combinación…"
    IDS_CAPTURE_MODIFIER    "Ctrl y Alt solo junto con una tecla; dos veces, solo Shift."
    IDS_CAPTURE_EMERGENCY   "Ctrl+Alt+Shift+F12 es la salida de emergencia; no se asigna."
    IDS_CAPTURE_NAMELESS    "Esta tecla no tiene nombre en el archivo de configuración — elija otra."
    IDS_CAPTURE_RESERVED    "El sistema ocupa esta tecla — elija otra."
    IDS_CAPTURE_TYPING      "Esta tecla hace falta al escribir — elija otra."
    IDS_HOTKEY_HINT         "Una tecla, una combinación con Ctrl, Alt, Shift o un Shift doble."
    IDS_CAPTURE_COMBO_NOTE  "{0} sin {1} queda para los programas."
    IDS_CAPTURE_SHIFT_AGAIN "Otra vez Shift — pulsación doble; una tecla con Shift — combinación."
    IDS_CAPTURE_DOUBLE_NOTE "Dos pulsaciones de Shift seguidas. La escritura normal con Shift no cambia."
    IDS_ALREADY_RUNNING     "Lang Switcher ya se está ejecutando en esta sesión."
    IDS_STATE_WORKING       "En marcha"
    IDS_STATE_SUSPENDED     "En pausa"
    IDS_STATE_HOOK_ABSENT   "La interceptación de teclado no está instalada"
    IDS_STATE_DISABLED      "La interceptación está instalada, pero el procesamiento está desactivado: reinicie el programa"
    IDS_STATE_HEALTH        "retiradas silenciosas de la interceptación: {0} · fallos de instalación: {1} · pulsaciones perdidas: {2}"
    IDS_STATE_PAIR          "Par activo: {0} → {1}"
    IDS_STATE_CYCLE         "Ciclo activo: {0}"
    IDS_STATE_PAIR_NONE     "No hay par activo"
