    IDS_MODE_CYCLE          "Varias distribuciones"
    IDS_PAIR_SOURCE         "Origen:"
    IDS_PAIR_TARGET         "Destino:"
    IDS_CYCLE_HINT          "Ciclo: la casilla participa, los botones ordenan"
