#pragma code_page(65001)
// res/lang/en.rc -- English, the strings of the interface for `[general] language = "en"`.
//
// Stage L10N, task T-L10N-2: the two string tables of this language -- the dialog block and the
// menu block -- moved here out of app.rc unchanged; app.rc includes this file, and the built
// RT_STRING resource stayed byte for byte what it was. The rules every table obeys stand in
// app.rc above the #include lines; where each string is seen and how much room it has is
// res/lang/context.tsv; tests/l10n.rs holds this file to en.rc.
//
// ⚠ In an .rc string a backslash is an escape -- one backslash is written as two -- and a double
// quote inside a string is written as two double quotes. The code page line above is this
// file's own: without it rc.exe reads the file in the ANSI code page, silently.

// ---------------------------------------------------------------------------------------
// English — `[general] language = "en"`.
// ---------------------------------------------------------------------------------------
LANGUAGE 0x09, 0x01
STRINGTABLE
BEGIN
    IDS_DIALOG_CAPTION      "Lang Switcher — Settings"
    IDS_GROUP_GENERAL       "General"
    IDS_AUTOSTART           "Start when I sign in"
    IDS_LANGUAGE_LABEL      "Interface language:"
    IDS_GROUP_HOTKEY        "Hotkey"
    IDS_HOTKEY_LABEL        "Key:"
    IDS_HOTKEY_SET          "Set"
    IDS_HOTKEY_STOP         "Cancel"
    IDS_GROUP_LAYOUTS       "Layouts"
    IDS_MODE_PAIR           "Pair"
    IDS_MODE_CYCLE          "Several layouts"
    IDS_PAIR_SOURCE         "Source:"
    IDS_PAIR_TARGET         "Target:"
    IDS_CYCLE_HINT          "Cycle: the tick takes part, the buttons set the order"
    IDS_CYCLE_UP            "Up"
    IDS_CYCLE_DOWN          "Down"
    IDS_SELECTION_ENABLED   "Convert the selected text"
    IDS_GROUP_EXCLUSIONS    "Exclusions"
    IDS_EXCLUSION_REMOVE    "Remove"
    IDS_EXCLUSION_ADD       "Add"
    IDS_EXCLUSION_HINT      "Process name, for example game.exe"
    IDS_EXCLUSION_AUTO      "Automatically"
    IDS_EXCLUSION_MANUAL    "Manually"
    IDS_EXCLUSION_PICK      "Pick a program window"
    IDS_EXCLUSION_PICK_NOTE "Click, then switch to the program within 5 seconds"
    IDS_EXCLUSION_PICK_COUNT "Switch to the program you need… {0}"
    IDS_EXCLUSION_ADDED     "Added: {0}"
    IDS_EXCLUSION_ALREADY   "Already in the list: {0}"
    IDS_EXCLUSION_NOT_PICKED "No window picked"
    IDS_GROUP_DIAGNOSTICS   "Diagnostics"
    IDS_LOG_ENABLED         "Keep a journal"
    IDS_LOG_OPEN            "Open the journal folder"
    IDS_LOG_SAVE            "Save the journal"
    IDS_LOG_SAVE_FAILED     "The journal could not be saved."
    IDS_LOG_SAVED           "Journal saved"
    IDS_LOG_DIR_LABEL       "Journal folder:"
    IDS_GROUP_STATE         "State"
    IDS_OK                  "OK"
    IDS_CANCEL              "Cancel"
    IDS_APPLY               "Apply"
    IDS_NOTE_TEXT_KEY       "This is a text key: while the program is active it will stop typing its character."
    IDS_NOTE_UNKNOWN_KEY    "The key name is not recognized — the default key, Pause, is in force."
    IDS_CAPTURE_PROMPT      "A key or a combination…"
    IDS_CAPTURE_MODIFIER    "Ctrl and Alt go only with a key; only Shift can be pressed twice."
    IDS_CAPTURE_EMERGENCY   "Ctrl+Alt+Shift+F12 is the emergency exit; it cannot be assigned."
    IDS_CAPTURE_NAMELESS    "This key has no name in the settings file — choose another one."
    IDS_CAPTURE_RESERVED    "The system owns this key — choose another one."
    IDS_CAPTURE_TYPING      "Typing needs this key — choose another one."
    IDS_HOTKEY_HINT         "A key, a combination with Ctrl, Alt, Shift, or a double Shift."
    IDS_CAPTURE_COMBO_NOTE  "{0} without {1} stays with your programs."
    IDS_CAPTURE_SHIFT_AGAIN "Shift again for a double press; a key with Shift for a combination."
    IDS_CAPTURE_DOUBLE_NOTE "Two presses of Shift in a row. Ordinary typing with Shift is not affected."
    IDS_ALREADY_RUNNING     "Lang Switcher is already running in this session."
    IDS_STATE_WORKING       "Working"
    IDS_STATE_SUSPENDED     "Suspended"
    IDS_STATE_HOOK_ABSENT   "The keyboard hook is not installed"
    IDS_STATE_DISABLED      "The hook is installed, but processing is off — restart the program"
    IDS_STATE_HEALTH        "silent hook removals: {0} · install failures: {1} · lost presses: {2}"
    IDS_STATE_PAIR          "Acting pair: {0} → {1}"
    IDS_STATE_CYCLE         "Acting cycle: {0}"
    IDS_STATE_PAIR_NONE     "No acting pair"
    IDS_STATE_NO_FAILURES   "no selection failures"
    IDS_STATE_FAILURES      "selection failures: {0}"
    IDS_STATE_JOINED        "{0} · {1}"
    IDS_STATE_LAYOUTS       "Layouts in the session: {0} · exclusions published: {1} · journal entries: {2}"
    IDS_STATE_AUTOSTART     "Autostart in the registry (HKCU\\…\\Run): {0}"
    IDS_AUTOSTART_PRESENT   "yes, {0}"
    IDS_AUTOSTART_ABSENT    "no"
    IDS_LAYOUT_NOTE         "The session has no layout named in the file ({0}) — choose again."
    IDS_LAYOUT_WORD_SOURCE  "source"
    IDS_LAYOUT_WORD_TARGET  "target"
    IDS_LOG_DIR_MISSING     "%APPDATA% is not set — there is nowhere to write the journal"
    IDS_THEME_LABEL         "Appearance:"
    IDS_THEME_SYSTEM        "Match system"
    IDS_THEME_LIGHT         "Light"
    IDS_THEME_DARK          "Dark"
    IDS_SOUND               "Sound feedback"
    IDS_ABOUT_CAPTION       "About"
    IDS_ABOUT_VERSION       "version {0}"
    IDS_ABOUT_LINE_1        "Fixes text typed in the wrong keyboard layout."
    IDS_ABOUT_LINE_2        "Conversion takes a single key press."
    IDS_ABOUT_OK            "OK"
    IDS_ABOUT_HELP          "How to use it"
    IDS_ABOUT_HELP_1        "You typed a word in the wrong layout — press {0}: the word is converted and the layout switches."
    IDS_ABOUT_HELP_2        "Pressing {0} again brings the original text back."
    IDS_ABOUT_HELP_3        "Select text and press {0} — the selection is converted (if enabled and Ctrl+C works)."
    IDS_ABOUT_HELP_4        "Suspend, settings and exit are in the tray icon."
    IDS_ABOUT_HELP_5        "To change the key: Settings → Hotkey."
    IDS_CAPTURE_HINT        "Esc or a click elsewhere cancels"
    IDS_TIP_ACTIVE          "active"
    IDS_TIP_PAUSED          "suspended"
    IDS_LETTER_CAPTION      "A letter from the author"
    IDS_CLOSE               "Close"
    IDS_CHANNEL_OPEN        "Open the channel"
    IDS_FEEDBACK_OPEN       "Open GitHub Issues"
    IDS_SUPPORT_OPEN        "Support the author"
    IDS_HELLO_TITLE         "Hello! My name is Panda."
    IDS_HELLO_LEAD          "I made Lang Switcher and I am glad you installed it. The program does one thing: it fixes a word typed in the wrong layout. Here is what that looks like:"
    IDS_HELLO_DEMO_CAP      "You typed «руддщ», pressed {0} and got «hello», with the layout switched to English. Press it again and it is back as it was."
    IDS_HELLO_PANEL         "Three things for the first day"
    IDS_HELLO_ROW_1         "{0} converts the last word you typed and switches the layout. It works in any window."
    IDS_HELLO_ROW_2         "Press {0} again and the word comes back exactly as it was, letter for letter."
    IDS_HELLO_ROW_3         "The tray icon: pause, settings and «About», which has a «How to use it» section."
    IDS_HELLO_SETTINGS      "Open settings"
    IDS_HELLO_OK            "Got it"
    IDS_THANKS_TITLE        "A month has passed. Thank you!"
    IDS_THANKS_LEAD         "Hello, it is Panda again. You installed Lang Switcher a month ago, and I hope it suits you: I put a great deal of work into keeping it light and simply working."
    IDS_THANKS_PARA         "If you liked it, say so in GitHub Issues. If something is wrong, write to me: criticism matters too — a problem can only be fixed once somebody knows about it. The wizard is in the tray menu, under «Write to the author…»."
    IDS_SUPPORT_PANEL       "Support the author"
    IDS_SUPPORT_TEXT        "The program is free and will stay that way. If you would like to say thank you in deed, the support page lists a few ways. It is good that you value somebody else's work ♥"
    IDS_THANKS_SNOOZE       "Remind me in a week"
    IDS_THANKS_FOOT         "This letter is shown once."
    IDS_WHATSNEW_TITLE      "What is new in {0}"
    IDS_WHATSNEW_FROM       "you had {0} · updated today"
    IDS_WHATSNEW_TODAY      "updated today"
    IDS_WHATSNEW_PANEL      "Three changes"
    IDS_WHATSNEW_1          "The «State» panel speaks plainly: working / suspended / the hook is not installed / a restart is needed — and shows the acting pair of layouts and the refusals of selection."
    IDS_WHATSNEW_2          "The «Save the journal…» button writes the journal now; its header carries the time it was taken and says whether the session was still running."
    IDS_WHATSNEW_3          "The journal is more reliable: a failed write does not damage the previous file, «Keep a journal» acts at once in this session, and the grayed «Resume» says why it is gray."
    IDS_WHATSNEW_FULL       "The full list of changes is published in the channel."
    IDS_AUTHOR_CAPTION      "From the author"
    IDS_AUTHOR_PANEL        "The author"
    IDS_AUTHOR_TEXT         "The program is made by one person in their spare time. It is free and will stay that way. If you would like to say thank you in deed, the support page lists a few ways. It is good that you value somebody else's work ♥"
    IDS_NEWS_PANEL          "News and updates"
    IDS_NEWS_ABOUT_FEED     "Once a day the program reads a news file from the author's site and sends nothing about you. It downloads new versions from there and installs them itself after checking the signature."
    IDS_NEWS_NEVER_READ     "The feed has not been read yet."
    IDS_NEWS_READ_ON        "Feed read on {0}, the author's signature checks out."
    IDS_NEWS_LATEST         "Version {0} is installed, and it is the latest."
    IDS_NEWS_AVAILABLE      "Version {0} is installed, {1} is available."
    IDS_NEWS_DOWNLOAD       "Open the download page"
    IDS_NEWS_LETTERS        "Recent letters"
    IDS_NEWS_FILE_ONLY      "Can be turned off in the settings file: [letters] feed = false."
    IDS_NEWS_SWITCH         "Tell me about the author's updates and news"
    IDS_NEWS_SWITCH_SUB     "Once a day, the program reads one file from the author's site. This switch turns off the letters and news from that file."
    IDS_FEEDBACK_PANEL      "Feedback"
    IDS_FEEDBACK_TEXT       "Found a bug or have an idea? The wizard puts a message together in five steps. Nothing is sent by itself: the text goes to the clipboard, and you paste it."
    IDS_WRITE_TO_AUTHOR     "Write to the author…"
    IDS_LETTERS_CAPTION     "Recent letters"
    IDS_LETTERS_FOOT        "The three latest news items are kept. When a fourth arrives, the oldest goes, read or not."
    IDS_LETTERS_OPEN        "Open the letter"
    IDS_NEWS_READ_BUTTON    "Mark as read"
    IDS_MENU_UNREAD         "An unread letter…"
    IDS_MENU_UPDATE         "Version {0} is available…"
    IDS_TOAST_TITLE         "A letter from the author"
    IDS_TOAST_NEWS          "Panda has news for you. Click to read it, it will take a minute."
    IDS_TOAST_THANKS        "It has been a month since you installed it. Panda would like a word. Click to read it."
    IDS_TOAST_UPDATE_TITLE  "Version {0} is out"
    IDS_TOAST_UPDATE        "Three changes and a link to the download. Click to read it."
    IDS_TOAST_WHATSNEW      "Three changes. Click to read them."
    IDS_ABOUT_AUTHOR        "From the author…"
    IDS_ENTRY_UPDATE_MARK   "{0} · update · you have {1}"
    IDS_ENTRY_UNREAD_MARK   "{0} · not read"
    IDS_ENTRY_READ_MARK     "{0} · read"
    IDS_UPDATE_SUB          "you have {0} · released {1}"
    IDS_UPDATE_HOW          "How to update"
    IDS_UPDATE_STEP_1       "Press «Open the download page»: the latest version is always there."
    IDS_UPDATE_STEP_2       "Download the LangSwitcher-setup.exe file and run it."
    IDS_UPDATE_STEP_3       "The installer closes the program itself, replaces it and offers to start it again. Your settings are kept."
    IDS_UPDATE_FOOT         "The «Version {0} is available» entry stays in the tray menu until you update."
    IDS_NEWS_LETTER_TITLE   "News from the author"
    IDS_NEWS_LATER          "Later"
    IDS_NEWS_OPEN_LINK      "Open the link"
    IDS_NEWS_FOOT           "«Mark as read» closes the letter for good. «Later» or the cross: I will remind you in a week and once more in two, after that only the dot on the icon."
    IDS_WIZARD_CAPTION      "Write to the author"
    IDS_WIZARD_STEP         "Step {0} of {1}"
    IDS_WIZARD_CANCEL       "Cancel"
    IDS_WIZARD_BACK         "Back"
    IDS_WIZARD_NEXT         "Next"
    IDS_WIZARD_DONE         "Done"
    IDS_WIZARD_WHAT_TITLE   "What happened?"
    IDS_WIZARD_WHAT_NOTE    "The answer decides what the wizard asks about next."
    IDS_WIZARD_CARD_WRONG   "The program did the wrong thing"
    IDS_WIZARD_CARD_WRONG_SUB "the word came out converted wrongly, letters went missing, the layout was not the one"
    IDS_WIZARD_CARD_NOTHING "Nothing happened"
    IDS_WIZARD_CARD_NOTHING_SUB "you pressed the key and the text stayed as it was"
    IDS_WIZARD_CARD_IDEA    "I would like to suggest an improvement"
    IDS_WIZARD_CARD_IDEA_SUB "an idea, a wish, an inconvenience"
    IDS_WIZARD_WHERE_TITLE  "Where did it happen?"
    IDS_WIZARD_WHERE_NOTE   "The behavior depends on the window: a console, a browser and an editor take text in different ways. Switch to that window and the wizard writes the program's name itself."
    IDS_WIZARD_PROGRAM      "Program:"
    IDS_WIZARD_CAPTURE      "Take from the active window"
    IDS_WIZARD_CAPTURE_NOTE "The process name and the window class are taken. The window title is not: it often holds the name of a document."
    IDS_WIZARD_CAPTURE_COUNT "Switch to the window you need… {0}"
    IDS_WIZARD_WHERE_FIELD  "Input field"
    IDS_WIZARD_FIELD_NORMAL "An ordinary input field"
    IDS_WIZARD_FIELD_PASSWORD "A password field"
    IDS_WIZARD_FIELD_PASSWORD_SUB "in password fields the program does not work on purpose: keystrokes there are not remembered"
    IDS_WIZARD_FIELD_UNKNOWN "I do not know"
    IDS_WIZARD_DID_TITLE    "What were you doing?"
    IDS_WIZARD_DID_NOTE     "Write an example instead of the real text. The program keeps no keystrokes, so the appeal carries only what you write here."
    IDS_WIZARD_TYPED_IN     "Typed a word in the layout"
    IDS_WIZARD_AND_PRESSED  "and pressed"
    IDS_WIZARD_EXPECTED     "Expected:"
    IDS_WIZARD_GOT          "Got:"
    IDS_WIZARD_REPEAT       "Does it repeat?"
    IDS_WIZARD_REPEAT_ALWAYS "every time"
    IDS_WIZARD_REPEAT_SOMETIMES "sometimes"
    IDS_WIZARD_REPEAT_ONCE  "once"
    IDS_WIZARD_IDEA_TITLE   "Describe the idea"
    IDS_WIZARD_IDEA_NOTE    "Two questions. The more concrete the example, the easier it is to see what exactly to do."
    IDS_WIZARD_IDEA_WHAT    "What do you suggest?"
    IDS_WIZARD_IDEA_HELPS   "How would it help?"
    IDS_WIZARD_ATTACH_TITLE "What to attach?"
    IDS_WIZARD_ATTACH_NOTE  "Every item can be taken off. What each of them adds is written beside it."
    IDS_WIZARD_ATTACH_MACHINE "The program's version and the Windows build"
    IDS_WIZARD_ATTACH_LAYOUTS "The layouts in the system"
    IDS_WIZARD_ATTACH_SETTINGS "The settings"
    IDS_WIZARD_ATTACH_JOURNAL "The program's journal, out of memory"
    IDS_WIZARD_ATTACH_JOURNAL_SUB "Journal entries: {0}. Only operation names and error codes, not a single keystroke: that is how the journal itself is built"
    IDS_WIZARD_ATTACH_FOOT  "No journal file is needed: the entries are in memory while the program runs. If the problem repeats, turn the journal on in the settings and the entries will survive a restart."
    IDS_WIZARD_PREVIEW_TITLE "Check it and send"
    IDS_WIZARD_PREVIEW_NOTE "This is the whole text of the appeal. Edit anything you like. You send it yourself: the text goes to the clipboard and GitHub Issues opens in the browser."
    IDS_WIZARD_COPY         "Copy and open GitHub Issues"
    IDS_WIZARD_SAVE         "Save to the journal folder"
    IDS_WIZARD_COPIED_ONLY  "Copied. The address of GitHub Issues will appear in the next version."
    IDS_WIZARD_COPIED       "Copied, GitHub Issues is open."
    IDS_WIZARD_MAIL_NOTE    "This is the whole text of the appeal. Edit anything you like. It holds the program's journal and details of your computer, so send it to the author by email rather than to a public discussion."
    IDS_WIZARD_MAIL_ADDRESS "Email address: {0}"
    IDS_WIZARD_COPY_TEXT    "Copy the text"
    IDS_WIZARD_COPY_ADDRESS "Copy the address"
    IDS_WIZARD_TEXT_COPIED  "Text copied. Paste it into an email to {0}."
    IDS_WIZARD_ADDRESS_COPIED "Address copied: {0}."
    IDS_TOAST_UPDATED_TITLE "Lang Switcher has been updated to {0}"
    IDS_TOAST_UPDATED       "Click to see what's new."
    IDS_WIZARD_SAVED        "Saved: {0}"
    IDS_WIZARD_FAILED       "It did not work. The text is still in the window — copy it by hand."
    IDS_THANKYOU_BUG_TITLE  "Thank you for the bug report"
    IDS_THANKYOU_IDEA_TITLE "Thank you for the idea"
    IDS_THANKYOU_BUG_TEXT   "I read every appeal myself. Bugs I fix, and what matters to everybody I tell about in a letter in the program or in the channel. It is good that you found the time 🖤"
    IDS_THANKYOU_IDEA_TEXT  "I read every appeal myself. Ideas go into the plan and the best of them get made, and what matters to everybody I tell about in a letter in the program or in the channel. It is good that you found the time 🖤"
    IDS_LIST_SEPARATOR      ", "
    IDS_CYCLE_ARROW         " → "
    IDS_TIP_FORMAT          "{0} — {1}"
END

LANGUAGE 0x09, 0x01
STRINGTABLE
BEGIN
    IDS_MENU_SUSPEND        "Suspend"
    IDS_MENU_RESUME         "Resume"
    IDS_MENU_RESUME_RESTART "Resume — restart needed"
    IDS_MENU_SETTINGS       "Settings…"
    IDS_MENU_AUTOSTART      "Start when I sign in"
    IDS_MENU_ABOUT          "About"
    IDS_MENU_EXIT           "Exit"
END
