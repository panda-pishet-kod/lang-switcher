    IDS_WIZARD_REPEAT_SOMETIMES "noen ganger"
    IDS_WIZARD_REPEAT_ONCE  "én gang"
    IDS_WIZARD_IDEA_TITLE   "Beskriv ideen"
    IDS_WIZARD_IDEA_NOTE    "To spørsmål. Jo mer konkret eksempelet er, desto lettere er det å se hva som skal gjøres."
    IDS_WIZARD_IDEA_WHAT    "Hva foreslår du?"
    IDS_WIZARD_IDEA_HELPS   "Hvordan vil det hjelpe?"
    IDS_WIZARD_ATTACH_TITLE "Hva skal legges ved?"
    IDS_WIZARD_ATTACH_NOTE  "Hvert punkt kan fjernes. Ved siden av hvert punkt står det hva det legger til."
    IDS_WIZARD_ATTACH_MACHINE "Programversjon og Windows-bygg"
    IDS_WIZARD_ATTACH_LAYOUTS "Tastaturoppsett i systemet"
    IDS_WIZARD_ATTACH_SETTINGS "Innstillingene"
    IDS_WIZARD_ATTACH_JOURNAL "Programmets logg, fra minnet"
    IDS_WIZARD_ATTACH_JOURNAL_SUB "Loggoppføringer: {0}. Bare navn på operasjoner og feilkoder, ikke ett eneste tastetrykk: slik er selve loggen bygget opp"
